{%- comment -%}
  Section: Collection Carousel 14 (Puffy Collection Premium)
  Reference design: Meow Meow Wang "Chubby Cat Collection".

  Renders a high-conversion product carousel from a chosen collection:
    - Responsive grid: 4 columns desktop / 2 tablet / 1 mobile
    - Smooth horizontal scroll, left/right arrows, keyboard + touch/swipe
    - Auto-pause on hover, snap scrolling
    - Product card: 1:1 lazy image (WebP via CDN), discount badge,
      name, fractional star rating, review count, strikethrough + sale price,
      "Quick Shop" CTA -> product page
    - Ratings/reviews read from product metafields custom.rating / custom.reviews
    - Fires "product_view_from_carousel" analytics event on card click
{%- endcomment -%}

{%- liquid
  assign coll = collections[section.settings.collection]
  assign card_color = '#00B4D8'
  assign sale_color = '#E74C3C'
-%}

{%- style -%}
  #carousel-{{ section.id }} {
    --cc-bg: {{ section.settings.bg_color }};
    --cc-text: #1A1A1A;
    --cc-muted: #808080;
    --cc-muted-light: #CCCCCC;
    --cc-sale: {{ sale_color }};
    --cc-btn: {{ card_color }};
    --cc-star: #FFD700;
    --cc-badge: #E74C3C;
    --cc-gap: 16px;
    background: var(--cc-bg);
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    box-sizing: border-box;
  }
  #carousel-{{ section.id }} *,
  #carousel-{{ section.id }} *::before,
  #carousel-{{ section.id }} *::after { box-sizing: border-box; }

  #carousel-{{ section.id }} .cc-head {
    display: flex; align-items: center; justify-content: space-between;
    max-width: 1440px; margin: 0 auto 20px; gap: 16px;
  }
  #carousel-{{ section.id }} .cc-title {
    font-size: 28px; font-weight: 700; color: var(--cc-text); margin: 0; line-height: 1.2;
  }
  #carousel-{{ section.id }} .cc-nav { display: flex; gap: 8px; flex: 0 0 auto; }
  #carousel-{{ section.id }} .cc-arrow {
    width: 44px; height: 44px; border-radius: 50%; border: 1px solid #E5E5E5;
    background: #fff; color: var(--cc-text); cursor: pointer; display: grid; place-items: center;
    transition: all .3s ease; box-shadow: 0 2px 8px rgba(0,0,0,.08);
  }
  #carousel-{{ section.id }} .cc-arrow:hover { background: var(--cc-btn); color: #fff; border-color: var(--cc-btn); transform: scale(1.05); }
  #carousel-{{ section.id }} .cc-arrow:disabled { opacity: .35; cursor: default; transform: none; background: #fff; color: var(--cc-text); }
  #carousel-{{ section.id }} .cc-arrow svg { width: 18px; height: 18px; }

  #carousel-{{ section.id }} .cc-track-wrap { max-width: 1440px; margin: 0 auto; position: relative; }
  #carousel-{{ section.id }} .cc-track {
    display: grid; grid-auto-flow: column;
    grid-auto-columns: calc(25% - (var(--cc-gap) * 3 / 4));
    gap: var(--cc-gap);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    padding-bottom: 8px; -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  #carousel-{{ section.id }} .cc-track::-webkit-scrollbar { display: none; }

  #carousel-{{ section.id }} .cc-card {
    scroll-snap-align: start; background: #fff; border-radius: 8px; overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,.1); text-decoration: none; color: inherit;
    display: flex; flex-direction: column; transition: box-shadow .3s ease, transform .3s ease;
  }
  #carousel-{{ section.id }} .cc-card:hover { box-shadow: 0 4px 12px rgba(0,0,0,.15); transform: translateY(-2px); }

  #carousel-{{ section.id }} .cc-media { position: relative; aspect-ratio: 1 / 1; overflow: hidden; background: #f4f4f4; }
  #carousel-{{ section.id }} .cc-media img {
    width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 8px 8px 0 0;
    transition: transform .3s ease;
  }
  #carousel-{{ section.id }} .cc-card:hover .cc-media img { transform: scale(1.05); }

  #carousel-{{ section.id }} .cc-badge {
    position: absolute; top: 10px; left: 10px; z-index: 2;
    background: var(--cc-badge); color: #fff; font-weight: 700; font-size: 14px;
    padding: 8px 12px; border-radius: 6px; line-height: 1;
  }
  #carousel-{{ section.id }} .cc-best {
    position: absolute; top: 10px; right: 10px; z-index: 2;
    background: #1A1A1A; color: #fff; font-weight: 700; font-size: 10px; letter-spacing: .5px;
    padding: 6px 10px; border-radius: 6px; line-height: 1; text-transform: uppercase;
  }

  #carousel-{{ section.id }} .cc-body { padding: 12px 14px 16px; display: flex; flex-direction: column; gap: 4px; }
  #carousel-{{ section.id }} .cc-name {
    font-size: 14px; font-weight: 700; color: var(--cc-text); margin: 8px 0 0; line-height: 1.35;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 38px;
  }

  #carousel-{{ section.id }} .cc-rating { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--cc-muted); margin-top: 4px; }
  #carousel-{{ section.id }} .cc-stars { position: relative; display: inline-block; font-size: 13px; line-height: 1; letter-spacing: 1px; font-family: Arial, sans-serif; }
  #carousel-{{ section.id }} .cc-stars .cc-stars-bg { color: #E0E0E0; }
  #carousel-{{ section.id }} .cc-stars .cc-stars-fg { color: var(--cc-star); position: absolute; top: 0; left: 0; white-space: nowrap; overflow: hidden; }

  #carousel-{{ section.id }} .cc-reviews { font-size: 11px; color: var(--cc-muted-light); margin-top: 2px; }

  #carousel-{{ section.id }} .cc-price { display: flex; align-items: baseline; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
  #carousel-{{ section.id }} .cc-price-old { font-size: 12px; color: var(--cc-muted-light); text-decoration: line-through; }
  #carousel-{{ section.id }} .cc-price-new { font-size: 18px; font-weight: 700; color: var(--cc-sale); }

  #carousel-{{ section.id }} .cc-cta {
    margin-top: 12px; display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    background: var(--cc-btn); color: #fff; font-weight: 700; font-size: 13px;
    padding: 10px 20px; border-radius: 6px; border: none; cursor: pointer;
    transition: background .3s ease, transform .3s ease; text-decoration: none; width: 100%;
  }
  #carousel-{{ section.id }} .cc-cta:hover { background: #0090ad; transform: scale(1.05); }
  #carousel-{{ section.id }} .cc-cta svg { width: 15px; height: 15px; }

  @media (max-width: 1199px) {
    #carousel-{{ section.id }} .cc-track { grid-auto-columns: calc(50% - (var(--cc-gap) / 2)); }
    #carousel-{{ section.id }} .cc-title { font-size: 24px; }
  }
  @media (max-width: 767px) {
    #carousel-{{ section.id }} { padding-left: 16px; padding-right: 16px; }
    #carousel-{{ section.id }} .cc-track { grid-auto-columns: 85%; }
    #carousel-{{ section.id }} .cc-title { font-size: 20px; }
    #carousel-{{ section.id }} .cc-arrow { width: 40px; height: 40px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #carousel-{{ section.id }} .cc-track { scroll-behavior: auto; }
    #carousel-{{ section.id }} .cc-media img,
    #carousel-{{ section.id }} .cc-card,
    #carousel-{{ section.id }} .cc-cta { transition: none; }
  }
{%- endstyle -%}

<section
  id="carousel-{{ section.id }}"
  class="collection-carousel-14"
  data-carousel
  data-collection="{{ coll.handle }}"
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="cc-head">
    <h2 class="cc-title">{{ section.settings.heading }}</h2>
    <div class="cc-nav">
      <button class="cc-arrow" type="button" data-dir="prev" aria-label="Previous products">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="cc-arrow" type="button" data-dir="next" aria-label="Next products">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>

  <div class="cc-track-wrap">
    <div class="cc-track" data-track tabindex="0" role="list" aria-label="{{ section.settings.heading | escape }} products">
      {%- if coll and coll.products.size > 0 -%}
        {%- for product in coll.products limit: section.settings.max_products -%}
          {%- liquid
            assign price = product.price | divided_by: 100.0
            assign compare = product.compare_at_price | divided_by: 100.0
            assign has_compare = false
            if product.compare_at_price and product.compare_at_price > product.price
              assign has_compare = true
              assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
            endif
            assign rating = product.metafields.custom.rating.value | default: 0.0 | plus: 0.0
            assign reviews = product.metafields.custom.reviews.value | default: 0
            assign star_pct = rating | times: 20.0
          -%}
          <a
            class="cc-card"
            href="{{ product.url }}"
            role="listitem"
            data-product-card
            data-product-id="{{ product.id }}"
            data-product-handle="{{ product.handle }}"
            data-product-title="{{ product.title | escape }}"
          >
            <div class="cc-media">
              {%- if has_compare -%}
                <span class="cc-badge">-{{ discount }}%</span>
              {%- endif -%}
              {%- if product.tags contains 'best-seller' -%}
                <span class="cc-best">Best Seller</span>
              {%- endif -%}
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 600 }} 600w"
                  sizes="(max-width: 767px) 85vw, (max-width: 1199px) 50vw, 25vw"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="600" height="600" loading="lazy" decoding="async"
                >
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'cc-placeholder' }}
              {%- endif -%}
            </div>

            <div class="cc-body">
              <h3 class="cc-name">{{ product.title }}</h3>

              {%- if rating > 0 -%}
                <div class="cc-rating">
                  <span class="cc-stars" aria-hidden="true">
                    <span class="cc-stars-bg">★★★★★</span>
                    <span class="cc-stars-fg" style="width: {{ star_pct }}%;">★★★★★</span>
                  </span>
                  <span>({{ rating }})</span>
                </div>
                {%- if reviews > 0 -%}
                  <div class="cc-reviews">{{ reviews }} reviews</div>
                {%- endif -%}
              {%- endif -%}

              <div class="cc-price">
                {%- if has_compare -%}
                  <span class="cc-price-old">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
                <span class="cc-price-new">{{ product.price | money }}</span>
              </div>

              <span class="cc-cta" data-quick-shop>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                {{ section.settings.cta_label }}
              </span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        <p style="color:#808080;padding:24px;">Select a collection in the theme editor to display products.</p>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('carousel-{{ section.id }}');
    if (!root || root.dataset.ccInit) return;
    root.dataset.ccInit = '1';

    var track = root.querySelector('[data-track]');
    var prev = root.querySelector('[data-dir="prev"]');
    var next = root.querySelector('[data-dir="next"]');
    if (!track) return;

    function step() {
      var card = track.querySelector('.cc-card');
      var gap = 16;
      var w = card ? card.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
      return Math.max(w, 200);
    }
    function scrollByDir(dir) {
      track.scrollBy({ left: dir * step(), behavior: 'smooth' });
    }
    function updateArrows() {
      if (!prev || !next) return;
      var maxScroll = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= maxScroll;
    }

    if (prev) prev.addEventListener('click', function () { scrollByDir(-1); });
    if (next) next.addEventListener('click', function () { scrollByDir(1); });
    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    updateArrows();

    // Keyboard navigation when the track is focused
    track.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { e.preventDefault(); scrollByDir(1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); scrollByDir(-1); }
    });

    // Auto-scroll with pause on hover / touch / focus
    var auto = {{ section.settings.autoscroll | default: false }};
    var timer = null;
    function start() {
      if (!auto || timer) return;
      timer = setInterval(function () {
        var maxScroll = track.scrollWidth - track.clientWidth - 2;
        if (track.scrollLeft >= maxScroll) { track.scrollTo({ left: 0, behavior: 'smooth' }); }
        else { scrollByDir(1); }
      }, {{ section.settings.autoscroll_interval | default: 3500 }});
    }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    if (auto) {
      start();
      ['mouseenter', 'touchstart', 'focusin'].forEach(function (ev) { root.addEventListener(ev, stop, { passive: true }); });
      ['mouseleave', 'touchend', 'focusout'].forEach(function (ev) { root.addEventListener(ev, start, { passive: true }); });
      document.addEventListener('visibilitychange', function () { if (document.hidden) { stop(); } else { start(); } });
    }

    // Analytics: fire on card click, then let navigation proceed
    root.querySelectorAll('[data-product-card]').forEach(function (card) {
      card.addEventListener('click', function () {
        var payload = {
          event: 'product_view_from_carousel',
          product_id: card.getAttribute('data-product-id'),
          product_handle: card.getAttribute('data-product-handle'),
          product_title: card.getAttribute('data-product-title'),
          collection: root.getAttribute('data-collection')
        };
        try { window.dataLayer = window.dataLayer || []; window.dataLayer.push(payload); } catch (e) {}
        try { if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) { Shopify.analytics.publish('product_view_from_carousel', payload); } } catch (e) {}
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection Carousel 14",
  "tag": "section",
  "class": "section-collection-carousel-14",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Puffy Collection Premium" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "max_products", "label": "Max products", "min": 4, "max": 24, "step": 1, "default": 14 },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Quick Shop" },
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "header", "content": "Auto-scroll" },
    { "type": "checkbox", "id": "autoscroll", "label": "Enable auto-scroll (pauses on hover)", "default": false },
    { "type": "range", "id": "autoscroll_interval", "label": "Auto-scroll interval", "min": 2000, "max": 8000, "step": 500, "default": 3500, "unit": "ms" }
  ],
  "presets": [
    { "name": "Collection Carousel 14", "settings": { "heading": "Puffy Collection Premium" } }
  ]
}
{% endschema %}
