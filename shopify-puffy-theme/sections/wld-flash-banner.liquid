<div id="wldfb-{{ section.id }}" class="wldfb">
  <div class="wldfb-in">
    <span class="wldfb-emoji">🚀</span>
    <span class="wldfb-txt">{{ section.settings.text }}</span>
    <span class="wldfb-timer">{{ section.settings.timer_label }} <b data-wld-countdown>02:47:12</b></span>
    <a class="wldfb-cta" href="{{ section.settings.link | default: '/collections/all' }}">{{ section.settings.cta }}</a>
  </div>
</div>
{% style %}
#wldfb-{{ section.id }} { background:linear-gradient(90deg,#FF6B35,#E03131); color:#fff; font-family:'Poppins',sans-serif; }
#wldfb-{{ section.id }} .wldfb-in { max-width:1180px; margin:0 auto; padding:12px 24px; display:flex; align-items:center; justify-content:center; gap:16px; flex-wrap:wrap; text-align:center; }
#wldfb-{{ section.id }} .wldfb-emoji { font-size:18px; }
#wldfb-{{ section.id }} .wldfb-txt { font-weight:800; font-size:15px; letter-spacing:.01em; }
#wldfb-{{ section.id }} .wldfb-timer { font-weight:700; font-size:14px; background:rgba(255,255,255,.18); padding:6px 12px; border-radius:99px; }
#wldfb-{{ section.id }} .wldfb-timer b { font-variant-numeric:tabular-nums; }
#wldfb-{{ section.id }} .wldfb-cta { background:#fff; color:#E03131; font-weight:800; font-size:13.5px; text-decoration:none; padding:9px 20px; border-radius:99px; white-space:nowrap; transition:transform .15s; }
#wldfb-{{ section.id }} .wldfb-cta:hover { transform:translateY(-1px); }
@media (max-width:640px){ #wldfb-{{ section.id }} .wldfb-in { gap:10px; padding:10px 16px; } #wldfb-{{ section.id }} .wldfb-txt { font-size:12.5px; } #wldfb-{{ section.id }} .wldfb-timer { font-size:12.5px; } }
{% endstyle %}
{% schema %}
{
  "name": "WLD — Flash Banner",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "text", "label": "Banner text", "default": "🚀 FLASH SALE: -30% + FREE WORLDWIDE SHIPPING" },
    { "type": "text", "id": "timer_label", "label": "Timer label", "default": "Ends in" },
    { "type": "text", "id": "cta", "label": "Button text", "default": "SHOP THE SALE →" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [ { "name": "WLD — Flash Banner" } ]
}
{% endschema %}
