<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">

      <div class="site-footer__brand">
        {%- if section.settings.logo != blank -%}
          <img class="site-footer__logo" src="{{ section.settings.logo | image_url: width: 320 }}" alt="{{ shop.name }}" width="160">
        {%- else -%}
          <div class="site-footer__brand-name">{{ section.settings.brand_name | default: shop.name }}</div>
        {%- endif -%}
        <p>{{ section.settings.brand_text | default: 'Skincare • Beauty • Confidence. Cosmétiques K-beauty premium, livrés partout au Maroc.' }}</p>
        <div class="site-footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v7h3v-7h2.5l.5-3H14V9c0-.6.4-1 1-1Z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 3c.3 2 1.6 3.5 3.5 3.8v2.7c-1.3 0-2.5-.4-3.5-1v5.9c0 3-2.4 5.4-5.4 5.4S5.2 17.4 5.2 14.4 7.6 9 10.6 9c.3 0 .6 0 .9.1v2.8c-.3-.1-.6-.2-.9-.2-1.4 0-2.5 1.1-2.5 2.5s1.1 2.5 2.5 2.5 2.6-1.1 2.6-2.5V3H16Z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_youtube != blank -%}
            <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.5-.4-5.1a2.6 2.6 0 0 0-1.8-1.8C19.1 4.7 12 4.7 12 4.7s-7.1 0-8.8.4a2.6 2.6 0 0 0-1.8 1.8C1 8.5 1 12 1 12s0 3.5.4 5.1a2.6 2.6 0 0 0 1.8 1.8c1.7.4 8.8.4 8.8.4s7.1 0 8.8-.4a2.6 2.6 0 0 0 1.8-1.8C23 15.5 23 12 23 12ZM10 15V9l5 3-5 3Z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h4>{{ block.settings.title }}</h4>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- elsif block.type == 'text' -%}
          <div {{ block.shopify_attributes }}>
            <h4>{{ block.settings.title }}</h4>
            <div class="rte" style="font-size:0.9rem;">{{ block.settings.text }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} — {{ 'footer.rights' | t }}</span>
      <div class="payment-icons">
        <span>💵 COD</span>
        <span>VISA</span>
        <span>MASTERCARD</span>
        <span>CMI</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (pied de page)" },
    { "type": "text", "id": "brand_name", "label": "Nom de la marque (si pas de logo)" },
    { "type": "textarea", "id": "brand_text", "label": "Texte de présentation" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Colonne de menu",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Liens rapides" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "text",
      "name": "Colonne de texte",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Service client" },
        { "type": "richtext", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pied de page",
      "blocks": [
        { "type": "menu", "settings": { "title": "Liens rapides" } },
        { "type": "menu", "settings": { "title": "Service client" } },
        { "type": "text", "settings": { "title": "Contact", "text": "<p>📞 06 XX XX XX XX<br>✉️ contact@authentique.ma<br>📍 Maroc</p>" } }
      ]
    }
  ]
}
{% endschema %}
