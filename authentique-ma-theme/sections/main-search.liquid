<section class="section">
  <div class="container">
    <div class="page-header"><h1>{{ 'general.search.search' | t }}</h1></div>

    <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:560px; margin:0 auto 34px; display:flex; gap:10px;">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}"
        style="flex:1; padding:14px 18px; border-radius:var(--button-radius); border:1px solid rgba(74,18,89,0.2); font:inherit;">
      <button type="submit" class="btn btn--primary">{{ 'general.search.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        <p style="text-align:center; color:#6b5b72; margin-bottom:24px;">{{ 'general.search.results_for' | t: terms: search.terms }}</p>
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- render 'product-card', product: item, show_add_button: true -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p style="text-align:center; color:#6b5b72;">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Recherche", "settings": [] }
{% endschema %}
