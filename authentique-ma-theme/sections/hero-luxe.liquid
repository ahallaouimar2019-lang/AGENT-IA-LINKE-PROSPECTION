{%- comment -%}
  Authentique MA — Luxury before/after hero
  Pure white, minimal, floating iPhone with buttery before/after slider.
  Vanilla JS + CSS (works natively in Shopify — no React needed).
{%- endcomment -%}

<section class="lux-hero" data-lux-hero>
  <div class="lux-hero__grid">

    {# ---------- LEFT (45%) ---------- #}
    <div class="lux-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="lux-hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="lux-hero__headline">{{ section.settings.headline }}</h1>
      <p class="lux-hero__sub">{{ section.settings.subheadline }}</p>

      <div class="lux-hero__actions">
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="lux-btn">
          {{ section.settings.cta_label }}
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div class="lux-hero__trust">
        <span class="lux-hero__stars">★★★★★</span>
        <span class="lux-hero__trust-text">{{ section.settings.trust_text }}</span>
      </div>
    </div>

    {# ---------- RIGHT (55%) ---------- #}
    <div class="lux-hero__stage">
      <div class="lux-phone" data-lux-phone>
        <div class="lux-phone__island"></div>
        <div class="lux-phone__screen">

          <div class="lux-compare" data-lux-compare>
            {# BEFORE (base layer) #}
            <div class="lux-compare__img lux-compare__before">
              {%- if section.settings.before_image -%}
                <img src="{{ section.settings.before_image | image_url: width: 900 }}" alt="Avant" width="600" height="800" draggable="false">
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: '' }}
              {%- endif -%}
              <span class="lux-tag lux-tag--before">AVANT</span>
            </div>
            {# AFTER (clipped layer) #}
            <div class="lux-compare__img lux-compare__after" data-lux-after>
              {%- if section.settings.after_image -%}
                <img src="{{ section.settings.after_image | image_url: width: 900 }}" alt="Après" width="600" height="800" draggable="false">
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: '' }}
              {%- endif -%}
              <span class="lux-tag lux-tag--after">APRÈS</span>
            </div>
            {# Divider + handle #}
            <div class="lux-divider" data-lux-divider>
              <span class="lux-handle">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 6 4 12l5 6M15 6l5 6-5 6"/></svg>
              </span>
            </div>
          </div>

          <div class="lux-phone__glare"></div>
        </div>
      </div>
    </div>

  </div>
</section>

{% style %}
  .lux-hero { background: #ffffff; padding: clamp(48px, 7vw, 110px) clamp(20px, 5vw, 80px); overflow: hidden; }
  .lux-hero__grid { max-width: 1280px; margin-inline: auto; display: grid; grid-template-columns: 45% 55%; align-items: center; gap: clamp(24px, 4vw, 60px); }
  .lux-hero__copy { max-width: 520px; }
  .lux-hero__eyebrow { display: inline-block; font-family: var(--body-font); font-size: 0.72rem; letter-spacing: 0.32em; text-transform: uppercase; color: #8a8a8a; margin-bottom: 26px; }
  .lux-hero__headline { font-family: var(--heading-font); font-weight: 500; font-size: clamp(2.4rem, 4.4vw, 4rem); line-height: 1.05; letter-spacing: -0.02em; color: #111; margin: 0 0 22px; }
  .lux-hero__sub { font-size: clamp(1rem, 1.2vw, 1.15rem); line-height: 1.65; color: #5c5c5c; margin: 0 0 38px; max-width: 44ch; font-weight: 300; }
  .lux-hero__actions { margin-bottom: 26px; }
  .lux-btn { display: inline-flex; align-items: center; gap: 10px; background: #111; color: #fff; font-family: var(--body-font); font-weight: 500; font-size: 1rem; padding: 17px 34px; border-radius: 100px; letter-spacing: 0.01em; box-shadow: 0 10px 30px rgba(0,0,0,0.12); transition: transform .3s cubic-bezier(.2,.8,.2,1), box-shadow .3s; }
  .lux-btn:hover { color: #fff; transform: translateY(-2px); box-shadow: 0 16px 40px rgba(0,0,0,0.18); }
  .lux-btn svg { transition: transform .3s; }
  .lux-btn:hover svg { transform: translateX(4px); }
  .lux-hero__trust { display: flex; align-items: center; gap: 12px; }
  .lux-hero__stars { color: #111; letter-spacing: 3px; font-size: 0.95rem; }
  .lux-hero__trust-text { font-size: 0.82rem; letter-spacing: 0.18em; text-transform: uppercase; color: #9a9a9a; }

  .lux-hero__stage { display: flex; justify-content: center; align-items: center; perspective: 1400px; }
  .lux-phone {
    position: relative; width: min(340px, 78vw); aspect-ratio: 9 / 19; border-radius: 52px;
    background: #0b0b0b; padding: 12px;
    box-shadow: 0 40px 90px -30px rgba(30,20,40,0.45), 0 8px 20px rgba(0,0,0,0.12), inset 0 0 2px 2px rgba(255,255,255,0.08);
    animation: lux-float 6s ease-in-out infinite;
    will-change: transform;
  }
  .lux-phone::before { content:''; position:absolute; top:22%; inset-inline-start:-2px; width:2px; height:44px; background:#0b0b0b; border-radius:2px; box-shadow:0 60px 0 #0b0b0b; }
  .lux-phone::after { content:''; position:absolute; top:30%; inset-inline-end:-2px; width:2px; height:64px; background:#0b0b0b; border-radius:2px; }
  .lux-phone__island { position:absolute; top:22px; left:50%; transform:translateX(-50%); width:96px; height:28px; background:#000; border-radius:16px; z-index:6; }
  .lux-phone__screen { position:relative; width:100%; height:100%; border-radius:42px; overflow:hidden; background:#f3eef6; }

  .lux-compare { position:absolute; inset:0; touch-action:none; cursor:ew-resize; user-select:none; }
  .lux-compare__img { position:absolute; inset:0; }
  .lux-compare__img img, .lux-compare__img svg { width:100%; height:100%; object-fit:cover; display:block; pointer-events:none; }
  .lux-compare__after { clip-path: inset(0 50% 0 0); will-change: clip-path; }
  .lux-tag { position:absolute; top:16px; font-size:0.6rem; letter-spacing:0.16em; font-weight:600; padding:5px 10px; border-radius:100px; background:rgba(255,255,255,0.85); color:#333; backdrop-filter:blur(6px); }
  .lux-tag--before { inset-inline-start:16px; }
  .lux-tag--after { inset-inline-end:16px; background:rgba(17,17,17,0.82); color:#fff; }

  .lux-divider { position:absolute; top:0; bottom:0; left:50%; width:2px; background:rgba(255,255,255,0.95); transform:translateX(-50%); box-shadow:0 0 12px rgba(0,0,0,0.25); z-index:5; will-change:left; }
  .lux-handle {
    position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    width:44px; height:44px; border-radius:50%; background:rgba(255,255,255,0.92);
    display:flex; align-items:center; justify-content:center; color:#111;
    box-shadow:0 4px 18px rgba(0,0,0,0.28), 0 0 0 6px rgba(255,255,255,0.28);
    backdrop-filter:blur(4px); transition:box-shadow .25s, transform .25s;
  }
  .lux-compare.is-dragging .lux-handle { box-shadow:0 6px 24px rgba(0,0,0,0.35), 0 0 0 10px rgba(255,255,255,0.2); }
  .lux-handle svg { opacity:0.75; }

  .lux-phone__glare { position:absolute; inset:0; border-radius:42px; pointer-events:none; z-index:7;
    background:linear-gradient(115deg, rgba(255,255,255,0) 30%, rgba(255,255,255,0.18) 45%, rgba(255,255,255,0) 60%);
    background-size:250% 250%; animation:lux-glare 7s ease-in-out infinite; }

  @keyframes lux-float { 0%,100%{ transform:translateY(0) rotate(0deg);} 50%{ transform:translateY(-16px) rotate(-0.4deg);} }
  @keyframes lux-glare { 0%{ background-position:120% 0;} 50%{ background-position:-40% 0;} 100%{ background-position:120% 0;} }

  @media (max-width: 900px) {
    .lux-hero__grid { grid-template-columns:1fr; text-align:center; gap:44px; }
    .lux-hero__copy { max-width:none; margin-inline:auto; }
    .lux-hero__sub { margin-inline:auto; }
    .lux-hero__trust { justify-content:center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lux-phone { animation:none; } .lux-phone__glare { animation:none; }
  }
{% endstyle %}

<script>
  (function () {
    var section = document.querySelector('[data-lux-hero]');
    if (!section) return;
    var compare = section.querySelector('[data-lux-compare]');
    var after = section.querySelector('[data-lux-after]');
    var divider = section.querySelector('[data-lux-divider]');
    if (!compare || !after || !divider) return;

    var pos = 25, raf = null, userInteracted = false;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function render() {
      after.style.clipPath = 'inset(0 ' + (100 - pos) + '% 0 0)';
      divider.style.left = pos + '%';
    }
    function setPos(p) {
      pos = p < 2 ? 2 : (p > 98 ? 98 : p);
      if (!raf) raf = requestAnimationFrame(function () { render(); raf = null; });
    }

    // ----- Drag -----
    function fromEvent(e) {
      var rect = compare.getBoundingClientRect();
      var x = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
      setPos((x / rect.width) * 100);
    }
    function down(e) { userInteracted = true; compare.classList.add('is-dragging'); fromEvent(e); window.addEventListener('pointermove', fromEvent); window.addEventListener('pointerup', up); }
    function up() { compare.classList.remove('is-dragging'); window.removeEventListener('pointermove', fromEvent); window.removeEventListener('pointerup', up); }
    compare.addEventListener('pointerdown', down);

    // ----- Autoplay: 25 -> 75 -> 50 over 3s -----
    function easeInOut(t) { return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2; }
    function tween(from, to, dur, done) {
      var start = null;
      function step(ts) {
        if (userInteracted) return;
        if (!start) start = ts;
        var t = Math.min((ts - start) / dur, 1);
        setPos(from + (to - from) * easeInOut(t));
        if (t < 1) requestAnimationFrame(step); else if (done) done();
      }
      requestAnimationFrame(step);
    }
    render();
    if (!reduce) {
      setTimeout(function () {
        if (userInteracted) return;
        tween(25, 75, 1600, function () { tween(75, 50, 1400); });
      }, 500);
    } else { pos = 50; render(); }

    // Reveal on scroll into view (start autoplay only when visible)
  })();
</script>

{% schema %}
{
  "name": "Hero Luxe (Avant/Après)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "AUTHENTIQUE MA" },
    { "type": "text", "id": "headline", "label": "Titre", "default": "Reveal Younger Eyes In Seconds." },
    { "type": "textarea", "id": "subheadline", "label": "Sous-titre", "default": "A revolutionary eye cream that smooths fine lines, reduces dark circles, and restores a naturally fresh look." },
    { "type": "text", "id": "cta_label", "label": "Bouton — texte", "default": "Shop Now" },
    { "type": "url", "id": "cta_link", "label": "Bouton — lien" },
    { "type": "text", "id": "trust_text", "label": "Texte de confiance", "default": "Trusted By Thousands" },
    { "type": "header", "content": "Images Avant / Après" },
    { "type": "image_picker", "id": "before_image", "label": "Image AVANT (cernes visibles)" },
    { "type": "image_picker", "id": "after_image", "label": "Image APRÈS (peau fraîche)" }
  ],
  "presets": [ { "name": "Hero Luxe (Avant/Après)" } ]
}
{% endschema %}
