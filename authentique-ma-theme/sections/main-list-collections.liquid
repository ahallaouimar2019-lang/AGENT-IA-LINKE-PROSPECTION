<section class="section">
  <div class="container">
    <div class="page-header"><h1>{{ 'collections.general.title' | t }}</h1></div>
    <div class="collection-list">
      {%- for collection in collections -%}
        <a class="collection-tile" href="{{ collection.url }}">
          {%- if collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title }}" loading="lazy" width="500" height="600">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: '' }}
          {%- endif -%}
          <span class="collection-tile__label">{{ collection.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Liste des collections", "settings": [] }
{% endschema %}
