<section class="section{% if section.settings.soft_bg %} section--soft{% endif %}">
  <div class="container">
    <div class="section-heading">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.title }}</h2>
    </div>
    <div class="testimonials">
      {%- for block in section.blocks -%}
        <div class="testimonial" {{ block.shopify_attributes }}>
          <div class="testimonial__stars">{% for i in (1..block.settings.stars) %}★{% endfor %}</div>
          <p class="testimonial__text">« {{ block.settings.text }} »</p>
          <div class="testimonial__author">{{ block.settings.author }}{% if block.settings.city != blank %} — {{ block.settings.city }}{% endif %}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Avis clients",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "ELLES NOUS FONT CONFIANCE" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Ce que disent nos clientes" },
    { "type": "checkbox", "id": "soft_bg", "label": "Fond lilas doux", "default": false }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "range", "id": "stars", "label": "Étoiles", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Avis", "default": "Produit incroyable, ma peau est visiblement plus lisse en 2 semaines. Livraison rapide et paiement à la livraison, top !" },
        { "type": "text", "id": "author", "label": "Nom", "default": "Salma B." },
        { "type": "text", "id": "city", "label": "Ville", "default": "Casablanca" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avis clients",
      "blocks": [
        { "type": "review", "settings": { "author": "Salma B.", "city": "Casablanca" } },
        { "type": "review", "settings": { "text": "Enfin des produits coréens authentiques au Maroc ! Le service client est très réactif sur WhatsApp.", "author": "Imane K.", "city": "Rabat" } },
        { "type": "review", "settings": { "text": "J'ai adoré le contour des yeux, texture légère et résultat bluffant. Je recommande à 100%.", "author": "Nada M.", "city": "Marrakech" } }
      ]
    }
  ]
}
{% endschema %}
