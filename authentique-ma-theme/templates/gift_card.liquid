<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carte cadeau — {{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
    {{ content_for_header }}
    <style>
      body { margin:0; font-family:'Poppins',sans-serif; background:#faf5fc; color:#2d1b33; text-align:center; padding:40px 20px; }
      .gc { max-width:460px; margin:0 auto; background:#fff; border-radius:18px; padding:36px; box-shadow:0 20px 50px rgba(74,18,89,0.12); }
      .gc h1 { font-family:'Playfair Display',serif; color:{{ settings.color_primary }}; }
      .gc__value { font-size:2.4rem; font-weight:700; color:{{ settings.color_primary }}; margin:14px 0; }
      .gc__code { font-family:monospace; font-size:1.2rem; letter-spacing:2px; background:#faf5fc; padding:12px; border-radius:10px; margin:16px 0; }
      .gc img { max-width:100%; }
    </style>
  </head>
  <body>
    <div class="gc">
      <h1>{{ shop.name }}</h1>
      <p>Votre carte cadeau</p>
      <div class="gc__value">{{ gift_card.balance | money }}</div>
      {{ gift_card.qr_identifier }}
      <div class="gc__code">{{ gift_card.code | format_code }}</div>
    </div>
  </body>
</html>
