<section class="section">
  <div class="container" style="max-width:460px;">
    <div class="page-header"><h1>Réinitialiser le mot de passe</h1></div>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="cod-field"><label>Nouveau mot de passe</label><input type="password" name="customer[password]" required></div>
      <div class="cod-field"><label>Confirmer</label><input type="password" name="customer[password_confirmation]" required></div>
      <button type="submit" class="btn btn--primary btn--block btn--lg">Réinitialiser</button>
    {%- endform -%}
  </div>
</section>
