{%- comment -%} Params: product, (optional) show_add_button {%- endcomment -%}
{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<div class="product-card">
  <a class="product-card__media" href="{{ product.url }}">
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 500 }}"
        srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 500 }} 500w, {{ product.featured_image | image_url: width: 700 }} 700w"
        sizes="(max-width: 749px) 45vw, 250px"
        alt="{{ product.featured_image.alt | escape | default: product.title }}"
        loading="lazy"
        width="500" height="500">
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'product-card__media' }}
    {%- endif -%}
    {%- if on_sale -%}
      <span class="product-card__badge product-card__badge--sale">{{ 'products.product.save' | t }}</span>
    {%- elsif product.available == false -%}
      <span class="product-card__badge">{{ 'products.product.sold_out' | t }}</span>
    {%- endif -%}
  </a>
  <div class="product-card__body">
    <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="product-card__price">
      {{ product.price | money }}
      {%- if on_sale -%}<span class="compare">{{ product.compare_at_price | money }}</span>{%- endif -%}
    </div>
    {%- if show_add_button -%}
      <a href="{{ product.url }}" class="btn btn--primary btn--block product-card__btn">{{ 'products.product.buy_now' | t }}</a>
    {%- endif -%}
  </div>
</div>
