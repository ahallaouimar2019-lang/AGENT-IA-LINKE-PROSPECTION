<div class="announce">
  {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.text }}</a>{% else %}{{ section.settings.text }}{% endif %}
</div>
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "☀️ SUMMER SALE — Buy 2 Save 15% · Buy 3 Save 30% · Free shipping over $50" },
    { "type": "url", "id": "link", "label": "Link (optional)" }
  ]
}
{% endschema %}
