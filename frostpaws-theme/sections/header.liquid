<header class="site-header">
  <div class="container nav">
    <a class="logo" href="{{ routes.root_url }}">
      {% if section.settings.logo %}
        <img src="{{ section.settings.logo | image_url: width: 300 }}" width="150" height="{{ 150 | divided_by: section.settings.logo.aspect_ratio | round }}" alt="{{ shop.name | escape }}">
      {% else %}
        {{ section.settings.logo_text }}<span class="accent">{{ section.settings.logo_accent }}</span><span class="flake-ic" aria-hidden="true">❄</span>
      {% endif %}
    </a>
    <nav class="nav-links" aria-label="Main navigation">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
      {% else %}
        <a href="/#problem">Why FrostPaws</a>
        <a href="/#size">Size Guide</a>
        <a href="/#reviews">Reviews</a>
        <a href="/#faq">FAQ</a>
      {% endif %}
    </nav>
    <div class="nav-right">
      {% if section.settings.cta_label != blank %}
        <a class="btn nav-cta" href="{{ section.settings.cta_link | default: '#buy' }}">{{ section.settings.cta_label }}</a>
      {% endif %}
      <a class="cart-link" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">🛒<i data-cart-count>{{ cart.item_count }}</i></a>
    </div>
  </div>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Optional — replaces the text logo." },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Frost" },
    { "type": "text", "id": "logo_accent", "label": "Logo accent text", "default": "Paws" },
    { "type": "link_list", "id": "menu", "label": "Menu", "info": "Optional — defaults to landing page anchors." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get Yours ❄️" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Defaults to the Hero buy box (#buy)." }
  ]
}
{% endschema %}
