<div class="page-content" style="max-width:440px">
  <h1>Create account</h1>
  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <p><input type="text" name="customer[first_name]" placeholder="First name" style="width:100%;border:1.5px solid var(--ice-mid);border-radius:12px;padding:12px"></p>
    <p><input type="email" name="customer[email]" placeholder="Email" style="width:100%;border:1.5px solid var(--ice-mid);border-radius:12px;padding:12px;margin-top:8px"></p>
    <p><input type="password" name="customer[password]" placeholder="Password" style="width:100%;border:1.5px solid var(--ice-mid);border-radius:12px;padding:12px;margin-top:8px"></p>
    <button class="btn" style="margin-top:12px">Create</button>
  {% endform %}
</div>
