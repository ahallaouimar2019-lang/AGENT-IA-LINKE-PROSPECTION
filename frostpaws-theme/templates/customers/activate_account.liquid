<div class="page-content" style="max-width:440px"><h1>Activate account</h1>
{% form 'activate_customer_password' %}
  {{ form.errors | default_errors }}
  <p><input type="password" name="customer[password]" placeholder="Password" style="width:100%;border:1.5px solid var(--ice-mid);border-radius:12px;padding:12px"></p>
  <p><input type="password" name="customer[password_confirmation]" placeholder="Confirm password" style="width:100%;border:1.5px solid var(--ice-mid);border-radius:12px;padding:12px;margin-top:8px"></p>
  <button class="btn" style="margin-top:12px">Activate</button>
{% endform %}</div>
