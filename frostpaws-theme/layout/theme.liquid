<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_accent | default: '#3BAEE9' }}">
  <title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {% if settings.favicon %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">{% endif %}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title | escape }}">
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:url" content="{{ canonical_url }}">
  {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">

  {{ content_for_header }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <style>
    :root{
      --accent: {{ settings.color_accent | default: '#3BAEE9' }};
      --navy: {{ settings.color_primary | default: '#12385D' }};
      --ice-soft: {{ settings.color_bg_soft | default: '#EAF7FF' }};
      --sun: {{ settings.color_star | default: '#FFC85C' }};
    }
  </style>
  <script>
    window.FP = {
      moneyFormat: {{ shop.money_format | json }},
      routes: { cart: {{ routes.cart_url | json }} }
    };
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% section 'announcement' %}
  {% section 'header' %}
  <main id="main">{{ content_for_layout }}</main>
  {% section 'footer' %}
  <script src="{{ 'app.js' | asset_url }}" defer></script>
</body>
</html>
