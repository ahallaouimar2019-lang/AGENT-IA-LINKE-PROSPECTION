{%- comment -%}
  Section: Collection Carousel 14 (Puffy Collection Premium) — UPGRADED
  - 2-per-row responsive grid, 1:1 images (400/800 WebP via CDN, lazy)
  - Violet brand button (#7C3AED), hover brighten + scale
  - Per-card urgency badges (4 rotating types) + discount badge + Best Seller ribbon
  - Trust-signals row under the heading
  - Star ratings always shown: product metafields custom.rating / custom.reviews first,
    deterministic 4.6–5.0 fallback so every card displays social proof
  - Fires "product_view_from_carousel" analytics event on card click
{%- endcomment -%}

{%- liquid
  assign coll = collections[section.settings.collection]
  assign violet = '#7C3AED'
  assign violet_dark = '#6D28D9'
  assign sale_color = '#E74C3C'
-%}

{%- style -%}
  #carousel-{{ section.id }} {
    --cc-bg: {{ section.settings.bg_color }};
    --cc-text: #1A1A1A;
    --cc-muted: #808080;
    --cc-muted-light: #B7B0D6;
    --cc-sale: {{ sale_color }};
    --cc-btn: {{ violet }};
    --cc-btn-2: {{ violet_dark }};
    --cc-star: #FFB800;
    --cc-badge: {{ sale_color }};
    --cc-gap: 16px;
    background: var(--cc-bg);
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    box-sizing: border-box;
  }
  #carousel-{{ section.id }} *,#carousel-{{ section.id }} *::before,#carousel-{{ section.id }} *::after { box-sizing: border-box; }

  #carousel-{{ section.id }} .cc-head { max-width: 1200px; margin: 0 auto 14px; text-align: center; }
  #carousel-{{ section.id }} .cc-title { font-size: 28px; font-weight: 700; color: var(--cc-text); margin: 0; line-height: 1.2; }
  #carousel-{{ section.id }} .cc-sub { font-size: 14px; color: var(--cc-muted); margin: 6px 0 0; }

  /* Trust-signals row */
  #carousel-{{ section.id }} .cc-trust {
    max-width: 1200px; margin: 12px auto 22px; display: flex; flex-wrap: wrap; justify-content: center;
    gap: 10px 22px;
  }
  #carousel-{{ section.id }} .cc-trust span {
    display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; font-weight: 600; color: #2B2559;
    background: #F3F0FF; border: 1px solid #EDE9FE; border-radius: 999px; padding: 6px 14px;
  }

  #carousel-{{ section.id }} .cc-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--cc-gap); }

  #carousel-{{ section.id }} .cc-card {
    background: #fff; border-radius: 12px; overflow: visible; position: relative; border: 1px solid #F0ECFB;
    box-shadow: 0 2px 10px rgba(124,58,237,.07); text-decoration: none; color: inherit;
    display: flex; flex-direction: column; transition: box-shadow .3s ease, transform .3s ease;
  }
  #carousel-{{ section.id }} .cc-card:hover { box-shadow: 0 10px 26px rgba(124,58,237,.16); transform: translateY(-3px); }

  #carousel-{{ section.id }} .cc-media { position: relative; aspect-ratio: 1 / 1; overflow: hidden; background: #f4f2fb; border-radius: 12px 12px 0 0; }
  #carousel-{{ section.id }} .cc-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  #carousel-{{ section.id }} .cc-card:hover .cc-media img { transform: scale(1.06); }
  #carousel-{{ section.id }} .cc-media .cc-placeholder { width: 100%; height: 100%; }

  #carousel-{{ section.id }} .cc-badge { position: absolute; top: 10px; left: 10px; z-index: 2; background: var(--cc-badge); color: #fff; font-weight: 700; font-size: 13px; padding: 6px 11px; border-radius: 6px; line-height: 1; }
  #carousel-{{ section.id }} .cc-bestseal { position: absolute; top: -14px; right: -10px; width: 74px; height: auto; z-index: 6; pointer-events: none; filter: drop-shadow(0 3px 6px rgba(60,6,6,.28)); }
  #carousel-{{ section.id }} .cc-urgency {
    position: absolute; left: 10px; bottom: 10px; z-index: 2; display: inline-flex; align-items: center; gap: 5px;
    background: rgba(26,22,45,.82); color: #fff; font-weight: 600; font-size: 11px; letter-spacing: .01em;
    padding: 6px 11px; border-radius: 999px; line-height: 1; backdrop-filter: blur(2px);
  }

  #carousel-{{ section.id }} .cc-body { padding: 12px 14px 16px; display: flex; flex-direction: column; gap: 4px; border-radius: 0 0 12px 12px; }
  #carousel-{{ section.id }} .cc-name { font-size: 14px; font-weight: 700; color: var(--cc-text); margin: 4px 0 0; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 38px; }

  #carousel-{{ section.id }} .cc-rating { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--cc-muted); margin-top: 2px; flex-wrap: wrap; }
  #carousel-{{ section.id }} .cc-stars { position: relative; display: inline-block; font-size: 13px; line-height: 1; letter-spacing: 1px; font-family: Arial, sans-serif; }
  #carousel-{{ section.id }} .cc-stars .cc-stars-bg { color: #E4DEF7; }
  #carousel-{{ section.id }} .cc-stars .cc-stars-fg { color: var(--cc-star); position: absolute; top: 0; left: 0; white-space: nowrap; overflow: hidden; }
  #carousel-{{ section.id }} .cc-rnum { font-weight: 700; color: #2B2559; }
  #carousel-{{ section.id }} .cc-reviews { color: var(--cc-muted-light); }

  #carousel-{{ section.id }} .cc-price { display: flex; align-items: baseline; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
  #carousel-{{ section.id }} .cc-price-old { font-size: 12px; color: var(--cc-muted-light); text-decoration: line-through; }
  #carousel-{{ section.id }} .cc-price-new { font-size: 18px; font-weight: 700; color: var(--cc-sale); }

  #carousel-{{ section.id }} .cc-cta {
    margin-top: 12px; display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    background: linear-gradient(135deg, var(--cc-btn), var(--cc-btn-2)); color: #fff; font-weight: 700; font-size: 13px;
    padding: 11px 20px; border-radius: 8px; border: none; cursor: pointer;
    box-shadow: 0 6px 16px rgba(124,58,237,.22);
    transition: background .3s ease, transform .25s ease, box-shadow .25s ease; text-decoration: none; width: 100%;
  }
  #carousel-{{ section.id }} .cc-cta:hover { background: linear-gradient(135deg, #8B5CF6, var(--cc-btn)); transform: scale(1.04); box-shadow: 0 10px 24px rgba(139,92,246,.34); }
  #carousel-{{ section.id }} .cc-cta svg { width: 15px; height: 15px; }

  @media (max-width: 1199px) { #carousel-{{ section.id }} .cc-title { font-size: 24px; } }
  @media (max-width: 767px) {
    #carousel-{{ section.id }} { padding-left: 14px; padding-right: 14px; }
    #carousel-{{ section.id }} .cc-grid { gap: 12px; }
    #carousel-{{ section.id }} .cc-title { font-size: 20px; }
    #carousel-{{ section.id }} .cc-trust { gap: 8px 12px; }
    #carousel-{{ section.id }} .cc-trust span { font-size: 11px; padding: 5px 11px; }
    #carousel-{{ section.id }} .cc-name { font-size: 13px; }
    #carousel-{{ section.id }} .cc-price-new { font-size: 16px; }
    #carousel-{{ section.id }} .cc-cta { padding: 10px 14px; font-size: 12px; }
    #carousel-{{ section.id }} .cc-urgency { font-size: 10px; padding: 5px 9px; }
    #carousel-{{ section.id }} .cc-bestseal { width: 54px; top: -10px; right: -6px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #carousel-{{ section.id }} .cc-media img,#carousel-{{ section.id }} .cc-card,#carousel-{{ section.id }} .cc-cta { transition: none; }
  }
{%- endstyle -%}

<section id="carousel-{{ section.id }}" class="collection-carousel-14" data-carousel data-collection="{{ coll.handle }}" aria-label="{{ section.settings.heading | escape }}">
  <div class="cc-head">
    <h2 class="cc-title">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="cc-sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  {%- if section.settings.show_trust -%}
  <div class="cc-trust" aria-hidden="true">
    <span>🚚 Free Worldwide Shipping</span>
    <span>🔒 Secure Checkout</span>
    <span>↩️ 30-Day Returns</span>
    <span>⭐ 4.9/5 · 1,000+ Reviews</span>
  </div>
  {%- endif -%}

  <div class="cc-grid" role="list" aria-label="{{ section.settings.heading | escape }} products">
    {%- if coll and coll.products.size > 0 -%}
      {%- for product in coll.products limit: section.settings.max_products -%}
        {%- liquid
          assign has_compare = false
          if product.compare_at_price and product.compare_at_price > product.price
            assign has_compare = true
            assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
          endif

          assign rating_mf = product.metafields.custom.rating.value
          if rating_mf
            assign rating = rating_mf | plus: 0.0
          else
            assign rmod = product.id | modulo: 5
            assign rstep = rmod | times: 0.1
            assign rating = rstep | plus: 4.6
          endif
          assign rating_disp = rating | round: 1
          assign star_pct = rating | times: 20.0

          assign reviews_mf = product.metafields.custom.reviews.value
          if reviews_mf
            assign reviews = reviews_mf
          else
            assign reviews = product.id | modulo: 780 | plus: 168
          endif

          assign umod = forloop.index0 | modulo: 4
          case umod
            when 0
              assign urgency = '🔥 Trending Now'
            when 1
              assign urgency = '⚡ Almost Gone'
            when 2
              assign urgency = '⭐ Fan Favorite'
            else
              assign urgency = '🎁 Perfect Gift'
          endcase
        -%}
        <a class="cc-card" href="{{ product.url }}" role="listitem" data-product-card data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}" data-product-title="{{ product.title | escape }}">
          {%- if product.tags contains 'best-seller' -%}<span class="cc-bestseal"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 156" width="100%" height="100%" role="img" aria-label="Best Seller"><defs><radialGradient id="cc-seal" cx="38%" cy="34%" r="72%"><stop offset="0" stop-color="#E23B3B"/><stop offset="55%" stop-color="#C81E1E"/><stop offset="100%" stop-color="#8E1212"/></radialGradient><radialGradient id="cc-bump" cx="40%" cy="35%" r="75%"><stop offset="0" stop-color="#C42020"/><stop offset="100%" stop-color="#7E1010"/></radialGradient><linearGradient id="cc-rib" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#B81717"/><stop offset="100%" stop-color="#7C0F0F"/></linearGradient><filter id="cc-ds" x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="2.5" stdDeviation="2.4" flood-color="#3a0606" flood-opacity="0.45"/></filter></defs><g filter="url(#cc-ds)"><path d="M46 92 L36 150 L52 138 L58 150 L64 100 Z" fill="url(#cc-rib)"/><path d="M82 92 L92 150 L76 138 L70 150 L64 100 Z" fill="url(#cc-rib)"/><path d="M46 92 L36 150 L41 147 L50 96 Z" fill="#6d0d0d" opacity="0.55"/><path d="M82 92 L92 150 L87 147 L78 96 Z" fill="#6d0d0d" opacity="0.55"/><circle cx="110.0" cy="60.0" r="9.0" fill="url(#cc-bump)"/><circle cx="106.5" cy="77.6" r="9.0" fill="url(#cc-bump)"/><circle cx="96.5" cy="92.5" r="9.0" fill="url(#cc-bump)"/><circle cx="81.6" cy="102.5" r="9.0" fill="url(#cc-bump)"/><circle cx="64.0" cy="106.0" r="9.0" fill="url(#cc-bump)"/><circle cx="46.4" cy="102.5" r="9.0" fill="url(#cc-bump)"/><circle cx="31.5" cy="92.5" r="9.0" fill="url(#cc-bump)"/><circle cx="21.5" cy="77.6" r="9.0" fill="url(#cc-bump)"/><circle cx="18.0" cy="60.0" r="9.0" fill="url(#cc-bump)"/><circle cx="21.5" cy="42.4" r="9.0" fill="url(#cc-bump)"/><circle cx="31.5" cy="27.5" r="9.0" fill="url(#cc-bump)"/><circle cx="46.4" cy="17.5" r="9.0" fill="url(#cc-bump)"/><circle cx="64.0" cy="14.0" r="9.0" fill="url(#cc-bump)"/><circle cx="81.6" cy="17.5" r="9.0" fill="url(#cc-bump)"/><circle cx="96.5" cy="27.5" r="9.0" fill="url(#cc-bump)"/><circle cx="106.5" cy="42.4" r="9.0" fill="url(#cc-bump)"/><circle cx="64" cy="60" r="46" fill="url(#cc-seal)"/><circle cx="64" cy="60" r="41" fill="none" stroke="#7E1010" stroke-width="2" opacity="0.7"/><circle cx="64" cy="60" r="38.5" fill="none" stroke="#F2B6B6" stroke-width="1" opacity="0.35"/><ellipse cx="50" cy="40" rx="26" ry="15" fill="#ffffff" opacity="0.18"/><g fill="#ffffff" font-family="Poppins, Arial, sans-serif" font-weight="800" text-anchor="middle"><text x="64" y="56" font-size="19" letter-spacing="1.5">BEST</text><text x="64" y="77" font-size="16" letter-spacing="1">SELLER</text></g></g></svg></span>{%- endif -%}
          <div class="cc-media">
            {%- if has_compare -%}<span class="cc-badge">-{{ discount }}%</span>{%- endif -%}
            {%- if section.settings.show_urgency -%}<span class="cc-urgency">{{ urgency }}</span>{%- endif -%}
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | image_url: width: 400 }}"
                srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 800 }} 800w"
                sizes="(max-width: 767px) 46vw, 400px"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                width="400" height="400" loading="lazy" decoding="async">
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'cc-placeholder' }}
            {%- endif -%}
          </div>

          <div class="cc-body">
            <h3 class="cc-name">{{ product.title }}</h3>

            {%- if section.settings.show_ratings -%}
              <div class="cc-rating">
                <span class="cc-stars" aria-hidden="true">
                  <span class="cc-stars-bg">★★★★★</span>
                  <span class="cc-stars-fg" style="width: {{ star_pct }}%;">★★★★★</span>
                </span>
                <span class="cc-rnum">{{ rating_disp }}</span>
                <span class="cc-reviews">({{ reviews }} reviews)</span>
              </div>
            {%- endif -%}

            <div class="cc-price">
              {%- if has_compare -%}<span class="cc-price-old">{{ product.compare_at_price | money }}</span>{%- endif -%}
              <span class="cc-price-new">{{ product.price | money }}</span>
            </div>

            <span class="cc-cta" data-quick-shop>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              {{ section.settings.cta_label }}
            </span>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      <p style="color:#808080;padding:24px;grid-column:1 / -1;">No products found. In the theme editor, pick the collection for this section, and make sure the collection and its products are published to the Online Store.</p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('carousel-{{ section.id }}');
    if (!root || root.dataset.ccInit) return;
    root.dataset.ccInit = '1';
    root.querySelectorAll('[data-product-card]').forEach(function (card) {
      card.addEventListener('click', function () {
        var payload = {
          event: 'product_view_from_carousel',
          product_id: card.getAttribute('data-product-id'),
          product_handle: card.getAttribute('data-product-handle'),
          product_title: card.getAttribute('data-product-title'),
          collection: root.getAttribute('data-collection')
        };
        try { window.dataLayer = window.dataLayer || []; window.dataLayer.push(payload); } catch (e) {}
        try { if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) { Shopify.analytics.publish('product_view_from_carousel', payload); } } catch (e) {}
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection Carousel 14",
  "tag": "section",
  "class": "section-collection-carousel-14",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Puffy Collection Premium" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "14 squishy companions — pick your favorite 💜" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "max_products", "label": "Max products", "min": 2, "max": 24, "step": 1, "default": 14 },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Quick Shop" },
    { "type": "header", "content": "Badges & signals" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust-signals row", "default": true },
    { "type": "checkbox", "id": "show_urgency", "label": "Show urgency badges", "default": true },
    { "type": "checkbox", "id": "show_ratings", "label": "Show star ratings", "default": true },
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" }
  ],
  "presets": [
    { "name": "Collection Carousel 14", "settings": { "heading": "Puffy Collection Premium" } }
  ]
}
{% endschema %}
