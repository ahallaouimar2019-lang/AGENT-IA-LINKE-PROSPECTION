{%- comment -%} Sticky countdown bar {%- endcomment -%}
{%- style -%}
  #cdb-{{ section.id }}{position:sticky;top:0;z-index:60;font-family:'Poppins',sans-serif;
    background:linear-gradient(135deg,#7C3AED,#6D28D9);color:#fff;text-align:center;
    padding:9px 14px;font-size:13.5px;font-weight:600;letter-spacing:.02em;display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap}
  #cdb-{{ section.id }} b{font-variant-numeric:tabular-nums;background:rgba(255,255,255,.18);padding:3px 10px;border-radius:6px;font-size:14px;letter-spacing:.06em}
  #cdb-{{ section.id }} a{color:#fff;text-decoration:underline;font-weight:700;white-space:nowrap}
  @media (max-width:540px){#cdb-{{ section.id }}{font-size:12px;padding:8px 10px;gap:7px}#cdb-{{ section.id }} b{font-size:13px;padding:2px 8px}}
{%- endstyle -%}
<div id="cdb-{{ section.id }}">
  <span>{{ section.settings.label }}</span>
  <b data-cdb>--:--:--</b>
  <a href="{{ section.settings.link }}">{{ section.settings.cta }}</a>
</div>
<script>
(function(){
  var el=document.querySelector('#cdb-{{ section.id }} [data-cdb]');
  if(!el)return;
  // Counts down to next local midnight, then rolls over (stable daily FOMO).
  function tick(){
    var now=new Date();
    var end=new Date(now.getFullYear(),now.getMonth(),now.getDate()+1,0,0,0);
    var d=Math.max(0,Math.floor((end-now)/1000));
    var h=String(Math.floor(d/3600)).padStart(2,'0');
    var m=String(Math.floor((d%3600)/60)).padStart(2,'0');
    var s=String(d%60).padStart(2,'0');
    el.textContent=h+':'+m+':'+s;
  }
  tick();setInterval(tick,1000);
})();
</script>
{% schema %}
{
  "name": "Puffy — Countdown Bar",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "⏰ FLASH SALE ENDS IN" },
    { "type": "text", "id": "cta", "label": "Link text", "default": "SHOP NOW →" },
    { "type": "url", "id": "link", "label": "Link", "default": "/collections/all" }
  ],
  "presets": [ { "name": "Puffy — Countdown Bar" } ]
}
{% endschema %}
