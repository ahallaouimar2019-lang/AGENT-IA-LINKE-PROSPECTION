cle cx="96.5" cy="27.5" r="9.0" fill="url(#sf-bump)"/><circle cx="106.5" cy="42.4" r="9.0" fill="url(#sf-bump)"/><circle cx="64" cy="60" r="46" fill="url(#sf-seal)"/><circle cx="64" cy="60" r="41" fill="none" stroke="#0B6B24" stroke-width="2" opacity="0.65"/><circle cx="64" cy="60" r="38.5" fill="none" stroke="#ffffff" stroke-width="1" opacity="0.28"/><ellipse cx="50" cy="40" rx="26" ry="15" fill="#ffffff" opacity="0.16"/><g fill="#ffffff" font-family="Poppins, Arial, sans-serif" font-weight="800" text-anchor="middle"><text x="64" y="70" font-size="26" letter-spacing="2">SAFE</text></g></g></svg></span><span class="hj-seal"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 156" width="100%" height="100%" role="img" aria-label="Non-toxic"><defs><radialGradient id="nt-seal" cx="38%" cy="34%" r="72%"><stop offset="0" stop-color="#B98BF3"/><stop offset="55%" stop-color="#8B3FE8"/><stop offset="100%" stop-color="#5B21B6"/></radialGradient><radialGradient id="nt-bump" cx="40%" cy="35%" r="75%"><stop offset="0" stop-color="#7C3AED"/><stop offset="100%" stop-color="#5B21B6"/></radialGradient><linearGradient id="nt-rib" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8B3FE8"/><stop offset="100%" stop-color="#5B21B6"/></linearGradient><filter id="nt-ds" x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="2.5" stdDeviation="2.4" flood-color="#111" flood-opacity="0.4"/></filter></defs><g filter="url(#nt-ds)"><path d="M46 92 L36 150 L52 138 L58 150 L64 100 Z" fill="url(#nt-rib)"/><path d="M82 92 L92 150 L76 138 L70 150 L64 100 Z" fill="url(#nt-rib)"/><path d="M46 92 L36 150 L41 147 L50 96 Z" fill="#5B21B6" opacity="0.55"/><path d="M82 92 L92 150 L87 147 L78 96 Z" fill="#5B21B6" opacity="0.55"/><circle cx="110.0" cy="60.0" r="9.0" fill="url(#nt-bump)"/><circle cx="106.5" cy="77.6" r="9.0" fill="url(#nt-bump)"/><circle cx="96.5" cy="92.5" r="9.0" fill="url(#nt-bump)"/><circle cx="81.6" cy="102.5" r="9.0" fill="url(#nt-bump)"/><circle cx="64.0" cy="106.0" r="9.0" fill="url(#nt-bump)"/><circle cx="46.4" cy="102.5" r="9.0" fill="url(#nt-bump)"/><circle cx="31.5" cy="92.5" r="9.0" fill="url(#nt-bump)"/><circle cx="21.5" cy="77.6" r="9.0" fill="url(#nt-bump)"/><circle cx="18.0" cy="60.0" r="9.0" fill="url(#nt-bump)"/><circle cx="21.5" cy="42.4" r="9.0" fill="url(#nt-bump)"/><circle cx="31.5" cy="27.5" r="9.0" fill="url(#nt-bump)"/><circle cx="46.4" cy="17.5" r="9.0" fill="url(#nt-bump)"/><circle cx="64.0" cy="14.0" r="9.0" fill="url(#nt-bump)"/><circle cx="81.6" cy="17.5" r="9.0" fill="url(#nt-bump)"/><circle cx="96.5" cy="27.5" r="9.0" fill="url(#nt-bump)"/><circle cx="106.5" cy="42.4" r="9.0" fill="url(#nt-bump)"/><circle cx="64" cy="60" r="46" fill="url(#nt-seal)"/><circle cx="64" cy="60" r="41" fill="none" stroke="#5B21B6" stroke-width="2" opacity="0.65"/><circle cx="64" cy="60" r="38.5" fill="none" stroke="#ffffff" stroke-width="1" opacity="0.28"/><ellipse cx="50" cy="40" rx="26" ry="15" fill="#ffffff" opacity="0.16"/><g fill="#ffffff"><path d="M64 27 C60 22 53 22 51 27 C55 29 61 29 64 27 Z"/><path d="M64 27 C68 22 75 22 77 27 C73 29 67 29 64 27 Z"/><rect x="63" y="27" width="2" height="6" rx="1"/></g><g fill="#ffffff" font-family="Poppins, Arial, sans-serif" font-weight="800" text-anchor="middle"><text x="64" y="55" font-size="19" letter-spacing="1">NO</text><text x="64" y="76" font-size="18" letter-spacing="0.5">TOXIC</text></g><g fill="#ffffff"><ellipse cx="64" cy="90" rx="5" ry="4"/><circle cx="57" cy="85.5" r="2"/><circle cx="61.5" cy="83.5" r="2"/><circle cx="66.5" cy="83.5" r="2"/><circle cx="71" cy="85.5" r="2"/></g></g></svg></span></div>
        {%- if img != blank -%}
          <img src="{{ img | image_url: width: 880 }}"
               srcset="{{ img | image_url: width: 440 }} 440w, {{ img | image_url: width: 880 }} 880w"
               sizes="(max-width:767px) 92vw, (max-width:1119px) 340px, 440px"
               alt="{{ img.alt | default: section.settings.headline | escape }}"
               width="440" height="550" loading="eager" fetchpriority="high" decoding="async">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hj-ph' }}
        {%- endif -%}
      </figure>
    </div>
    <div class="hj-content">
      <h1 class="hj-h1">{{ section.settings.headline }}</h1>
      <p class="hj-sub">{{ section.settings.subheading }}</p>
      <p class="hj-desc">{{ section.settings.description }}</p>
      <div class="hj-badges">
        {%- assign badges = section.settings.badges | split: '|' -%}
        {%- for b in badges -%}
          {%- assign bt = b | strip -%}
          {%- if bt != blank -%}
          <span class="hj-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>{{ bt }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="hj-cta-row">
        <a class="hj-cta" href="{{ section.settings.cta_link | default: '/collections/all' }}">{{ section.settings.cta_text }}</a>
      </div>
      <a class="hj-cta2" href="{{ section.settings.cta2_link | default: '/collections/all' }}">{{ section.settings.cta2_text }}</a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Puffy — Hero Joy",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image (Puffy squishies)" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Transform Your Stress Into Joy" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Meet Puffy: Premium Squishy Cats Designed for Comfort" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Handcrafted with premium gel material, perfect for stress relief, gifts, or collection." },
    { "type": "text", "id": "badges", "label": "Badges (separate with |)", "default": "Free Shipping|30-Day Guarantee|1000+ Happy Customers" },
    { "type": "header", "content": "Primary button" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "SHOP THE COLLECTION →" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Secondary link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary text", "default": "View All Products" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_top", "label": "Background top", "default": "#F3F0FF" },
    { "type": "color", "id": "bg_bottom", "label": "Background bottom", "default": "#FFFFFF" },
    { "type": "range", "id": "pad_desktop", "label": "Section padding (desktop)", "min": 40, "max": 120, "step": 4, "default": 80, "unit": "px" }
  ],
  "presets": [ { "name": "Puffy — Hero Joy" } ]
}
{% endschema %}
