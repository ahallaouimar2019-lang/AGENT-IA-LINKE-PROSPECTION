{%- comment -%} FrostPaws™ — Main Cart {%- endcomment -%}
<section class="fp-section" data-fp-cart-page>
  <div class="fp-container">
    <header class="fp-section__head" style="text-align:left;margin-bottom:var(--fp-space-8)">
      <span class="fp-overline">Your cart</span>
      <h1 class="fp-h1" style="margin-top:var(--fp-space-3)">{{ section.settings.heading }}</h1>
    </header>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="fp-cart-layout" data-fp-cart-form>
        <div class="fp-cart-items">
          <div class="fp-cart-items__head fp-caption fp-muted">
            <span>Product</span><span>Quantity</span><span>Total</span>
          </div>
          {%- for item in cart.items -%}
            <div class="fp-cart-item" data-fp-cart-item data-key="{{ item.key }}" data-line="{{ forloop.index }}">
              <a class="fp-cart-item__media" href="{{ item.url }}">
                <div class="fp-media" style="aspect-ratio:1/1;width:88px;">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 200 | image_tag: class: 'fp-media__img', loading: 'lazy', widths: '88,176', sizes: '88px', alt: item.title }}
                  {%- else -%}
                    {% render 'frostpaws-image', ratio: '1/1', slot: 'PRODUCT_IMAGE', alt: item.title %}
                  {%- endif -%}
                </div>
              </a>
              <div class="fp-cart-item__info">
                <a class="fp-cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <span class="fp-caption fp-muted">{{ item.variant.title }}</span>
                {%- endunless -%}
                {%- if item.selling_plan_allocation -%}<span class="fp-caption fp-muted">{{ item.selling_plan_allocation.selling_plan.name }}</span>{%- endif -%}
                <span class="fp-cart-item__price fp-caption">{{ item.final_price | money }}</span>
              </div>
              <div class="fp-cart-item__qty">
                <div class="fp-qty" data-fp-line-qty>
                  <button type="button" class="fp-qty__btn" data-line-minus aria-label="Decrease">{% render 'frostpaws-icon', name: 'minus' %}</button>
                  <input class="fp-qty__input fp-tabular" type="number" value="{{ item.quantity }}" min="0"
                         data-line-qty-input data-line="{{ forloop.index }}" inputmode="numeric" aria-label="Quantity for {{ item.title | escape }}">
                  <button type="button" class="fp-qty__btn" data-line-plus aria-label="Increase">{% render 'frostpaws-icon', name: 'plus' %}</button>
                </div>
                <button type="button" class="fp-cart-item__remove fp-btn--text" data-line-remove="{{ forloop.index }}">Remove</button>
              </div>
              <div class="fp-cart-item__total fp-tabular">{{ item.final_line_price | money }}</div>
            </div>
          {%- endfor -%}
        </div>

        <aside class="fp-cart-summary">
          <div class="fp-card">
            <h2 class="fp-h3">Order summary</h2>
            <div class="fp-cart-summary__row"><span>Subtotal</span><span class="fp-tabular" data-fp-cart-subtotal>{{ cart.total_price | money }}</span></div>
            {%- if cart.total_discounts > 0 -%}
              <div class="fp-cart-summary__row fp-cart-summary__row--save"><span>Discounts</span><span class="fp-tabular">−{{ cart.total_discounts | money }}</span></div>
            {%- endif -%}
            <p class="fp-caption fp-muted">Shipping & taxes calculated at checkout.</p>
            {%- if section.settings.show_note -%}
              <label class="fp-sr-only" for="cart-note">Order note</label>
              <textarea id="cart-note" name="note" class="fp-textarea" placeholder="Add a note (optional)">{{ cart.note }}</textarea>
            {%- endif -%}
            <button type="submit" name="checkout" class="fp-btn fp-btn--primary fp-btn--full">
              <span>{% render 'frostpaws-icon', name: 'lock' %} Secure checkout</span>
            </button>
            <a class="fp-btn fp-btn--text" href="{{ routes.all_products_collection_url }}" style="justify-content:center;width:100%;margin-top:var(--fp-space-3)"><span class="fp-btn__label">Continue shopping</span></a>
            <div class="fp-trust" style="justify-content:center;margin-top:var(--fp-space-4)">
              <span class="fp-trust__item">{% render 'frostpaws-icon', name: 'lock' %} SSL secure</span>
              <span class="fp-trust__item">{% render 'frostpaws-icon', name: 'return' %} 30-night trial</span>
            </div>
          </div>
        </aside>
      </form>
    {%- else -%}
      <div class="fp-empty">
        <div class="fp-feature__icon" style="margin-inline:auto">{% render 'frostpaws-icon', name: 'cart' %}</div>
        <h2 class="fp-h3">Your cart is cool and empty</h2>
        <p class="fp-body fp-muted">Let's fix that. Find the perfect size and keep them cool all summer.</p>
        <a class="fp-btn fp-btn--primary" href="{{ routes.all_products_collection_url }}"><span>Shop FrostPaws</span></a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Review your order" },
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": true }
  ]
}
{% endschema %}
