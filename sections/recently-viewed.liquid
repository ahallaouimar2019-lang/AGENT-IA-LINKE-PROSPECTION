{%- comment -%} FrostPaws™ — Recently Viewed (client-side, localStorage) {%- endcomment -%}
<section class="fp-section {{ section.settings.bg_class }}" data-fp-recently-viewed
         data-limit="{{ section.settings.limit }}" data-current="{{ product.id }}" hidden>
  <div class="fp-container">
    <div class="fp-section__head">
      <span class="fp-overline">{{ section.settings.eyebrow }}</span>
      <h2 class="fp-h2" style="margin-top:var(--fp-space-3)">{{ section.settings.heading }}</h2>
    </div>
    <div class="fp-product-grid" data-fp-recently-viewed-grid></div>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "bg_class", "label": "Background", "default": "",
      "options": [ { "value": "", "label": "Snow" }, { "value": "fp-section--alt", "label": "Frost" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pick up where you left off" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "range", "id": "limit", "label": "Max products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [ { "name": "Recently viewed" } ]
}
{% endschema %}
