{%- comment -%} FrostPaws™ — Lifestyle Gallery (editorial grid) {%- endcomment -%}
<section class="fp-section {{ section.settings.bg_class }}" id="{{ section.settings.anchor | default: 'gallery' }}">
  <div class="fp-container">
    <div class="fp-section__head fp-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="fp-overline">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="fp-h2" style="margin-top:var(--fp-space-3)">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="fp-body-lg fp-muted" style="margin-top:var(--fp-space-4)">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="fp-gallery">
      {%- for block in section.blocks -%}
        {%- assign _ratio = '1/1' -%}
        {%- if block.settings.span == 'tall' -%}{%- assign _ratio = '3/4' -%}{%- elsif block.settings.span == 'wide' -%}{%- assign _ratio = '16/9' -%}{%- endif -%}
        <div class="fp-gallery__item fp-gallery__item--{{ block.settings.span }} fp-reveal" {{ block.shopify_attributes }}>
          {% render 'frostpaws-image',
             image: block.settings.image,
             ratio: _ratio,
             slot: block.settings.slot_id,
             alt: block.settings.alt,
             sizes: '(min-width:900px) 25vw, 50vw' %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lifestyle gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "gallery" },
    { "type": "select", "id": "bg_class", "label": "Background", "default": "",
      "options": [ { "value": "", "label": "Snow" }, { "value": "fp-section--alt", "label": "Frost" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In real homes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cooler days, everywhere they roam" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "From sunlit kitchens to shady patios — FrostPaws goes wherever your pet loves to lie." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "slot_id", "label": "Placeholder ID", "default": "GALLERY_IMAGE" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Pet relaxing on FrostPaws mat" },
        { "type": "select", "id": "span", "label": "Size", "default": "square",
          "options": [ { "value": "square", "label": "Square" }, { "value": "wide", "label": "Wide" }, { "value": "tall", "label": "Tall" } ] }
      ]
    }
  ],
  "max_blocks": 8,
  "default": {
    "settings": {},
    "blocks": [
      { "type": "photo", "settings": { "slot_id": "GALLERY_IMAGE_1", "span": "tall", "alt": "Dog stretched out on FrostPaws mat by a window" } },
      { "type": "photo", "settings": { "slot_id": "GALLERY_IMAGE_2", "span": "square", "alt": "Cat napping on FrostPaws mat" } },
      { "type": "photo", "settings": { "slot_id": "GALLERY_IMAGE_3", "span": "square", "alt": "FrostPaws mat detail shot" } },
      { "type": "photo", "settings": { "slot_id": "GALLERY_IMAGE_4", "span": "wide", "alt": "Dog cooling on a patio with FrostPaws" } },
      { "type": "photo", "settings": { "slot_id": "GALLERY_IMAGE_5", "span": "square", "alt": "Puppy on FrostPaws mat" } }
    ]
  },
  "presets": [ { "name": "Lifestyle gallery" } ]
}
{% endschema %}
