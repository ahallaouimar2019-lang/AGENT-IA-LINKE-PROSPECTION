{%- comment -%} FrostPaws™ — Main Product {%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="fp-section fp-product-main" id="fp-product-{{ section.id }}" data-fp-product
         data-product-url="{{ product.url }}">
  <script type="application/json" data-fp-product-summary>
    {
      "id": {{ product.id | json }},
      "title": {{ product.title | json }},
      "url": {{ product.url | json }},
      "image": {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 400 | json }}{%- else -%}null{%- endif -%},
      "price": {{ product.price | money | json }}
    }
  </script>
  <div class="fp-container">
    <nav class="fp-breadcrumb fp-caption" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a> <span aria-hidden="true">/</span>
      {%- if collection -%}<a href="{{ collection.url }}">{{ collection.title }}</a> <span aria-hidden="true">/</span>{%- endif -%}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="fp-product-layout">
      {%- comment -%} ---------- MEDIA GALLERY ---------- {%- endcomment -%}
      <div class="fp-product-gallery" data-fp-gallery>
        <div class="fp-product-gallery__main">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              {%- assign _ld = 'lazy' -%}
              {%- if forloop.first -%}{%- assign _ld = 'eager' -%}{%- endif -%}
              <div class="fp-product-gallery__slide {% if forloop.first %}is-active{% endif %}"
                   data-media-id="{{ media.id }}">
                <div class="fp-media" style="aspect-ratio:1/1;">
                  {{ media | image_url: width: 1400 | image_tag:
                     class: 'fp-media__img', loading: _ld,
                     widths: '400,600,800,1000,1200,1400',
                     sizes: '(min-width:1000px) 620px, 100vw',
                     alt: media.alt | default: product.title }}
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="fp-product-gallery__slide is-active">
              {% render 'frostpaws-image', ratio: '1/1', slot: 'PRODUCT_IMAGE', alt: product.title, eager: true, sizes: '(min-width:1000px) 620px, 100vw' %}
            </div>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="fp-product-gallery__thumbs" role="tablist" aria-label="Product images">
            {%- for media in product.media -%}
              <button type="button" class="fp-product-gallery__thumb {% if forloop.first %}is-active{% endif %}"
                      data-media-id="{{ media.id }}" role="tab" aria-label="View image {{ forloop.index }}">
                {{ media | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,160,240', sizes: '80px', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- PRODUCT INFO ---------- {%- endcomment -%}
      <div class="fp-product-info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

          {%- when 'vendor' -%}
            <span class="fp-overline" {{ block.shopify_attributes }}>{{ product.vendor | default: 'FrostPaws™' }}</span>

          {%- when 'title' -%}
            <h1 class="fp-h1" {{ block.shopify_attributes }}>{{ product.title }}</h1>

          {%- when 'rating' -%}
            <div class="fp-product-info__rating" {{ block.shopify_attributes }}>
              {% render 'frostpaws-stars', rating: 5 %}
              <a href="#reviews" class="fp-caption">{{ block.settings.rating_text }}</a>
            </div>

          {%- when 'price' -%}
            <div class="fp-product-info__price" data-fp-price {{ block.shopify_attributes }}>
              {% render 'frostpaws-price', product: product %}
            </div>
            {%- if block.settings.payment_note != blank -%}
              <p class="fp-caption fp-muted">{{ block.settings.payment_note }}</p>
            {%- endif -%}

          {%- when 'description_short' -%}
            {%- if product.description != blank -%}
              <div class="fp-body fp-muted fp-product-info__excerpt" {{ block.shopify_attributes }}>{{ product.description | strip_html | truncatewords: 40 }}</div>
            {%- else -%}
              <p class="fp-body fp-muted" {{ block.shopify_attributes }}>{{ block.settings.fallback }}</p>
            {%- endif -%}

          {%- when 'highlights' -%}
            <ul class="fp-product-highlights" role="list" {{ block.shopify_attributes }}>
              {%- assign hi = block.settings.items | newline_to_br | split: '<br />' -%}
              {%- for h in hi -%}
                {%- if h | strip != blank -%}
                  <li>{% render 'frostpaws-icon', name: 'check' %}<span>{{ h | strip }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'variant_picker' -%}
            <div class="fp-variant-picker" data-fp-variant-picker {{ block.shopify_attributes }}>
              {%- unless product.has_only_default_variant -%}
                {%- for option in product.options_with_values -%}
                  <fieldset class="fp-variant-option" data-option-index="{{ forloop.index0 }}">
                    <legend class="fp-variant-option__label">
                      <span class="fp-overline">{{ option.name }}</span>
                      <span class="fp-variant-option__value" data-option-selected="{{ forloop.index0 }}">{{ option.selected_value }}</span>
                    </legend>
                    <div class="fp-variant-option__values">
                      {%- for value in option.values -%}
                        {%- assign oid = section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 -%}
                        <input type="radio" class="fp-sr-only fp-variant-input" name="option-{{ section.id }}-{{ forloop.parentloop.index0 }}"
                               id="{{ oid }}" value="{{ value | escape }}"
                               data-option-index="{{ forloop.parentloop.index0 }}"
                               {% if option.selected_value == value %}checked{% endif %}>
                        <label class="fp-variant-swatch" for="{{ oid }}">{{ value }}</label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              {%- endunless -%}
              <script type="application/json" data-fp-variant-data>{{ product.variants | json }}</script>
              {%- if block.settings.size_guide_link -%}
                <a class="fp-btn fp-btn--text" href="{{ block.settings.size_guide_link }}"><span class="fp-btn__label">View size guide</span> <span class="fp-btn__arrow">→</span></a>
              {%- endif -%}
            </div>

          {%- when 'quantity' -%}
            <div class="fp-qty-wrap" {{ block.shopify_attributes }}>
              <span class="fp-overline">Quantity</span>
              <div class="fp-qty" data-fp-qty>
                <button type="button" class="fp-qty__btn" data-qty-minus aria-label="Decrease quantity">{% render 'frostpaws-icon', name: 'minus' %}</button>
                <input class="fp-qty__input fp-tabular" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
                <button type="button" class="fp-qty__btn" data-qty-plus aria-label="Increase quantity">{% render 'frostpaws-icon', name: 'plus' %}</button>
              </div>
            </div>

          {%- when 'buy_buttons' -%}
            {%- form 'product', product, id: 'fp-product-form', class: 'fp-product-form', novalidate: 'novalidate' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}" data-fp-variant-id>
              <div class="fp-buy-actions" {{ block.shopify_attributes }}>
                <div style="display:flex;gap:var(--fp-space-3);align-items:center;">
                  <button type="submit" name="add" class="fp-btn fp-btn--primary fp-btn--full fp-atc"
                          {% unless current_variant.available %}disabled{% endunless %} data-fp-atc data-label="{{ block.settings.atc_label | escape }}">
                    <span data-fp-atc-text>{% if current_variant.available %}{{ block.settings.atc_label }}{% else %}Sold out{% endif %}</span>
                  </button>
                  {%- if block.settings.show_wishlist -%}
                    <button type="button" class="fp-icon-btn fp-icon-btn--bordered" data-fp-wishlist="{{ product.id }}" aria-pressed="false" aria-label="Save to wishlist">
                      {% render 'frostpaws-icon', name: 'heart' %}
                    </button>
                  {%- endif -%}
                </div>
                {%- if block.settings.show_dynamic -%}{{ form | payment_button }}{%- endif -%}
              </div>
            {%- endform -%}

          {%- when 'trust' -%}
            <div class="fp-product-trust" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- assign ic = 'trust_icon_' | append: i -%}
                {%- assign tx = 'trust_text_' | append: i -%}
                {%- if block.settings[tx] != blank -%}
                  <span class="fp-trust__item">{% render 'frostpaws-icon', name: block.settings[ic] %} {{ block.settings[tx] }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'collapsible' -%}
            <details class="fp-product-collapsible" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>
                <span>{% if block.settings.icon != 'none' %}{% render 'frostpaws-icon', name: block.settings.icon %}{% endif %}{{ block.settings.heading }}</span>
                <svg class="fp-faq__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <div class="fp-product-collapsible__body fp-body">{{ block.settings.content }}</div>
            </details>

          {%- when 'complementary' -%}
            <div class="fp-complementary" data-fp-complementary
                 data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&intent=complementary&limit={{ block.settings.limit }}"
                 {{ block.shopify_attributes }}>
              {%- if recommendations.performed and recommendations.products_count > 0 -%}
                <span class="fp-overline">{{ block.settings.heading }}</span>
                <div class="fp-complementary__list">
                  {%- for rp in recommendations.products limit: block.settings.limit -%}
                    {% render 'frostpaws-product-card', product: rp, show_wishlist: false %}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} Sticky Add to Cart {%- endcomment -%}
  <div class="fp-sticky-atc fp-glass" data-fp-sticky-atc hidden>
    <div class="fp-sticky-atc__inner fp-container">
      <div class="fp-sticky-atc__info">
        {%- if product.featured_media -%}
          <span class="fp-sticky-atc__thumb">{{ product.featured_media | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48,96', sizes: '48px', alt: '' }}</span>
        {%- endif -%}
        <div>
          <span class="fp-sticky-atc__title">{{ product.title }}</span>
          <span class="fp-sticky-atc__price" data-fp-sticky-price>{{ current_variant.price | money }}</span>
        </div>
      </div>
      <button type="submit" form="fp-product-form" name="add" class="fp-btn fp-btn--primary fp-sticky-atc__btn"
              {% unless current_variant.available %}disabled{% endunless %}>
        <span>{{ section.settings.sticky_label }}</span>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "sticky_label", "label": "Sticky button label", "default": "Add to cart" }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "rating", "name": "Rating", "limit": 1, "settings": [
      { "type": "text", "id": "rating_text", "label": "Text", "default": "4.9 · 2,140 reviews" }
    ]},
    { "type": "price", "name": "Price", "limit": 1, "settings": [
      { "type": "text", "id": "payment_note", "label": "Payment note", "default": "Tax included. Free shipping over $60." }
    ]},
    { "type": "description_short", "name": "Short description", "limit": 1, "settings": [
      { "type": "textarea", "id": "fallback", "label": "Fallback text", "default": "The premium self-cooling mat that keeps your pet 3–5°C cooler — no water, no power, no fuss." }
    ]},
    { "type": "highlights", "name": "Highlights", "limit": 1, "settings": [
      { "type": "textarea", "id": "items", "label": "Items (one per line)", "default": "Pressure-activated cooling gel\nOrthopedic, joint-friendly support\nMachine-washable, chew-resistant cover\nNon-toxic, certified-safe materials" }
    ]},
    { "type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [
      { "type": "url", "id": "size_guide_link", "label": "Size guide link" },
      { "type": "checkbox", "id": "show_note", "label": "Reserved", "default": true }
    ]},
    { "type": "quantity", "name": "Quantity", "limit": 1 },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [
      { "type": "text", "id": "atc_label", "label": "Add to cart label", "default": "Add to cart — keep them cool" },
      { "type": "checkbox", "id": "show_dynamic", "label": "Show dynamic checkout button", "default": true },
      { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist button", "default": true }
    ]},
    { "type": "trust", "name": "Trust badges", "limit": 1, "settings": [
      { "type": "select", "id": "trust_icon_1", "label": "Icon 1", "default": "truck", "options": [
        {"value":"truck","label":"Truck"},{"value":"return","label":"Return"},{"value":"shield","label":"Shield"},{"value":"lock","label":"Lock"},{"value":"snowflake","label":"Snowflake"}
      ]},
      { "type": "text", "id": "trust_text_1", "label": "Text 1", "default": "Free 2–4 day shipping" },
      { "type": "select", "id": "trust_icon_2", "label": "Icon 2", "default": "return", "options": [
        {"value":"truck","label":"Truck"},{"value":"return","label":"Return"},{"value":"shield","label":"Shield"},{"value":"lock","label":"Lock"},{"value":"snowflake","label":"Snowflake"}
      ]},
      { "type": "text", "id": "trust_text_2", "label": "Text 2", "default": "30-night risk-free trial" },
      { "type": "select", "id": "trust_icon_3", "label": "Icon 3", "default": "lock", "options": [
        {"value":"truck","label":"Truck"},{"value":"return","label":"Return"},{"value":"shield","label":"Shield"},{"value":"lock","label":"Lock"},{"value":"snowflake","label":"Snowflake"}
      ]},
      { "type": "text", "id": "trust_text_3", "label": "Text 3", "default": "Secure checkout" }
    ]},
    { "type": "collapsible", "name": "Collapsible row", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "package", "options": [
        {"value":"none","label":"None"},{"value":"package","label":"Package"},{"value":"truck","label":"Truck"},{"value":"wash","label":"Wash"},{"value":"shield","label":"Shield"},{"value":"snowflake","label":"Snowflake"}
      ]},
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
      { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Free express shipping on orders over $60, delivered in 2–4 business days. Every FrostPaws ships with a 30-night trial — if it's not right, return it free.</p>" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
    ]},
    { "type": "complementary", "name": "Complete the set", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Pairs perfectly with" },
      { "type": "range", "id": "limit", "label": "Products", "min": 1, "max": 4, "step": 1, "default": 2 }
    ]}
  ],
  "presets": [
    { "name": "Product", "blocks": [
      { "type": "vendor" }, { "type": "title" }, { "type": "rating" }, { "type": "price" },
      { "type": "description_short" }, { "type": "highlights" }, { "type": "variant_picker" },
      { "type": "quantity" }, { "type": "buy_buttons" }, { "type": "trust" },
      { "type": "collapsible", "settings": { "heading": "How it works" } },
      { "type": "collapsible", "settings": { "heading": "Shipping & returns" } },
      { "type": "collapsible", "settings": { "heading": "Care & materials" } }
    ]}
  ]
}
{% endschema %}
