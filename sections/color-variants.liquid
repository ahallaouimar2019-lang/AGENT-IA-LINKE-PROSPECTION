{%- comment -%} FrostPaws™ — Color Variants {%- endcomment -%}
<section class="fp-section {{ section.settings.bg_class }}" id="{{ section.settings.anchor | default: 'colors' }}">
  <div class="fp-container">
    <div class="fp-colors" data-fp-colors>
      <div class="fp-colors__stage fp-reveal">
        {%- for block in section.blocks -%}
          {%- assign _cls = '' -%}
          {%- if forloop.first -%}{%- assign _cls = 'is-active' -%}{%- endif -%}
          {% render 'frostpaws-image',
             image: block.settings.image,
             ratio: '1/1',
             slot: block.settings.slot_id,
             alt: block.settings.name | append: ' FrostPaws mat',
             sizes: '(min-width:900px) 620px, 100vw',
             class: _cls %}
        {%- endfor -%}
      </div>
      <div class="fp-stack-lg fp-reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="fp-overline">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="fp-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="fp-body-lg fp-muted">{{ section.settings.subheading }}</p>{%- endif -%}
        <div class="fp-colors__swatches" role="group" aria-label="Choose a color">
          {%- for block in section.blocks -%}
            <button type="button" class="fp-swatch {% if forloop.first %}is-selected{% endif %}"
                    aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
              <span class="fp-swatch__dot" style="background:{{ block.settings.color }};"></span>
              <span class="fp-swatch__name">{{ block.settings.name }}</span>
            </button>
          {%- endfor -%}
        </div>
        {%- if section.settings.note != blank -%}<p class="fp-caption">{{ section.settings.note }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Color variants",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "colors" },
    { "type": "select", "id": "bg_class", "label": "Background", "default": "fp-section--alt",
      "options": [ { "value": "", "label": "Snow" }, { "value": "fp-section--alt", "label": "Frost" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Colorways" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A shade for every home" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Four calm, considered tones designed to sit quietly in your space — not shout across the room." },
    { "type": "text", "id": "note", "label": "Note", "default": "Each cover is dyed with pet-safe, fade-resistant pigments." }
  ],
  "blocks": [
    {
      "type": "variant",
      "name": "Color",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Glacier Blue" },
        { "type": "color", "id": "color", "label": "Swatch color", "default": "#BFD9E8" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "slot_id", "label": "Placeholder ID", "default": "COLOR_IMAGE" }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "settings": {},
    "blocks": [
      { "type": "variant", "settings": { "name": "Glacier Blue", "color": "#BFD9E8", "slot_id": "COLOR_GLACIER_IMAGE" } },
      { "type": "variant", "settings": { "name": "Snow", "color": "#F2F7FB", "slot_id": "COLOR_SNOW_IMAGE" } },
      { "type": "variant", "settings": { "name": "Midnight Navy", "color": "#1B3A5B", "slot_id": "COLOR_NAVY_IMAGE" } },
      { "type": "variant", "settings": { "name": "Warm Sand", "color": "#E9DFD3", "slot_id": "COLOR_SAND_IMAGE" } }
    ]
  },
  "presets": [ { "name": "Color variants" } ]
}
{% endschema %}
