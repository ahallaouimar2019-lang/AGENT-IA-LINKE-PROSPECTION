{%- comment -%} FrostPaws™ — Password (coming soon) {%- endcomment -%}
<section class="fp-hero" style="min-height:100vh;display:grid;place-items:center;text-align:center">
  <div class="fp-hero__halo" aria-hidden="true"></div>
  <div class="fp-container" style="position:relative;max-width:560px">
    <span class="fp-header__brand" style="font-size:1.75rem">{{ shop.name }}</span>
    <h1 class="fp-display" style="margin-block:var(--fp-space-6)">{{ section.settings.heading }}</h1>
    <p class="fp-body-lg fp-muted" style="margin-inline:auto">{{ section.settings.subheading }}</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<div class="fp-form-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="fp-search-field" style="margin-top:var(--fp-space-8);max-width:420px;margin-inline:auto">
        {% render 'frostpaws-icon', name: 'lock' %}
        <label class="fp-sr-only" for="pw">Password</label>
        <input id="pw" type="password" name="password" placeholder="Enter password" required>
        <button type="submit" class="fp-btn fp-btn--primary"><span>Enter</span></button>
      </div>
    {%- endform -%}

    {%- if section.settings.show_newsletter -%}
      <div style="margin-top:var(--fp-space-12)">
        <p class="fp-overline">{{ section.settings.news_heading }}</p>
        {%- form 'customer' -%}
          <input type="hidden" name="contact[tags]" value="prospect, password page">
          <div class="fp-search-field" style="margin-top:var(--fp-space-3);max-width:420px;margin-inline:auto">
            {% render 'frostpaws-icon', name: 'mail' %}
            <label class="fp-sr-only" for="pw-email">Email</label>
            <input id="pw-email" type="email" name="contact[email]" placeholder="Your email" required>
            <button type="submit" class="fp-btn fp-btn--secondary">Notify me</button>
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}

    <p class="fp-caption fp-muted" style="margin-top:var(--fp-space-12)">{% render 'frostpaws-icon', name: 'lock' %} Password protected storefront · Powered by Shopify</p>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something cool is coming" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "FrostPaws is almost ready. Premium self-cooling comfort for the pets you love — launching soon." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email capture", "default": true },
    { "type": "text", "id": "news_heading", "label": "Email heading", "default": "Be first to know" }
  ]
}
{% endschema %}
