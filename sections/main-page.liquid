{%- comment -%} FrostPaws™ — Generic Page / Policy {%- endcomment -%}
<section class="fp-section">
  <div class="fp-container" style="max-width:820px">
    <header class="fp-section__head" style="margin-bottom:var(--fp-space-8)">
      {%- if section.settings.eyebrow != blank -%}<span class="fp-overline">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="fp-h1" style="margin-top:var(--fp-space-3)">{{ page.title }}</h1>
    </header>
    <div class="fp-rte fp-body">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FrostPaws" }
  ]
}
{% endschema %}
