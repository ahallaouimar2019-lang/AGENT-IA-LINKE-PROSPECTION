{%- comment -%} FrostPaws™ — Benefits (image + alternating value rows) {%- endcomment -%}
<section class="fp-section {{ section.settings.bg_class }}" id="{{ section.settings.anchor | default: 'benefits' }}">
  <div class="fp-container">
    <div class="fp-grid" style="grid-template-columns:1fr;gap:var(--fp-space-12);align-items:center;" data-fp-benefits>
      <div class="fp-reveal">
        {% render 'frostpaws-image',
           image: section.settings.image,
           ratio: '4/5',
           slot: 'BENEFITS_IMAGE',
           alt: section.settings.image_alt,
           sizes: '(min-width:900px) 45vw, 100vw' %}
      </div>
      <div class="fp-stack-lg fp-reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="fp-overline">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="fp-h2">{{ section.settings.heading }}</h2>
        <div class="fp-stack-lg">
          {%- for block in section.blocks -%}
            <div style="display:flex;gap:var(--fp-space-4);align-items:flex-start;" {{ block.shopify_attributes }}>
              <span class="fp-feature__icon" style="flex-shrink:0;margin-bottom:0;">{% render 'frostpaws-icon', name: block.settings.icon %}</span>
              <div>
                <h3 class="fp-h3">{{ block.settings.title }}</h3>
                <p class="fp-body fp-muted" style="margin-top:var(--fp-space-1)">{{ block.settings.text }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media(min-width:900px){
    #{{ section.settings.anchor | default: 'benefits' }} [data-fp-benefits]{grid-template-columns:0.9fr 1.1fr}
  }
</style>

{% schema %}
{
  "name": "Benefits",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "benefits" },
    { "type": "select", "id": "bg_class", "label": "Background", "default": "fp-section--alt",
      "options": [ { "value": "", "label": "Snow" }, { "value": "fp-section--alt", "label": "Frost" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The details" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Small touches, big difference" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Alt text", "default": "FrostPaws mat close-up in a bright home" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "snowflake",
          "options": [
            { "value": "snowflake", "label": "Snowflake" }, { "value": "feather", "label": "Feather" },
            { "value": "wash", "label": "Wash" }, { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" }, { "value": "clock", "label": "Clock" },
            { "value": "drop", "label": "Drop" }, { "value": "sparkle", "label": "Sparkle" }
          ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Stays cool for hours" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Advanced gel holds its temperature far longer than foam or water mats." }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "settings": {},
    "blocks": [
      { "type": "benefit", "settings": { "icon": "clock", "title": "Cool for hours", "text": "Advanced pressure-gel holds its temperature far longer than foam or water mats — through the whole afternoon." } },
      { "type": "benefit", "settings": { "icon": "feather", "title": "Kind on joints", "text": "A gentle orthopedic layer cushions hips and elbows, so older pets rest easier." } },
      { "type": "benefit", "settings": { "icon": "wash", "title": "Effortlessly clean", "text": "Removable, machine-washable cover and a wipe-clean surface. Fresh in minutes." } },
      { "type": "benefit", "settings": { "icon": "leaf", "title": "Safe & non-toxic", "text": "Food-grade cooling gel and OEKO-TEX certified fabric — safe against skin and paws." } }
    ]
  },
  "presets": [ { "name": "Benefits" } ]
}
{% endschema %}
