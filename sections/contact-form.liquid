{%- comment -%} FrostPaws™ — Contact {%- endcomment -%}
<section class="fp-section">
  <div class="fp-container">
    <div class="fp-contact">
      <div class="fp-stack-lg">
        <div>
          <span class="fp-overline">{{ section.settings.eyebrow }}</span>
          <h1 class="fp-h1" style="margin-top:var(--fp-space-3)">{{ section.settings.heading }}</h1>
          <p class="fp-body-lg fp-muted" style="margin-top:var(--fp-space-4)">{{ section.settings.subheading }}</p>
        </div>
        <ul class="fp-contact__list" role="list">
          {%- if section.settings.email != blank -%}
            <li><span class="fp-feature__icon">{% render 'frostpaws-icon', name: 'mail' %}</span><div><span class="fp-caption fp-muted">Email</span><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></div></li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li><span class="fp-feature__icon">{% render 'frostpaws-icon', name: 'phone' %}</span><div><span class="fp-caption fp-muted">Phone</span><a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></div></li>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <li><span class="fp-feature__icon">{% render 'frostpaws-icon', name: 'clock' %}</span><div><span class="fp-caption fp-muted">Support hours</span><span>{{ section.settings.hours }}</span></div></li>
          {%- endif -%}
        </ul>
      </div>

      <div class="fp-card fp-contact__card">
        {%- form 'contact', novalidate: 'novalidate' -%}
          {%- if form.posted_successfully? -%}
            <div class="fp-form-success" role="status">Thanks — we'll be in touch within one business day. 🐾</div>
          {%- elsif form.errors -%}
            <div class="fp-form-error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="fp-field-row">
            <div class="fp-field"><label for="cf-name">Name</label><input id="cf-name" type="text" name="contact[name]" autocomplete="name" required></div>
            <div class="fp-field"><label for="cf-email">Email</label><input id="cf-email" type="email" name="contact[email]" autocomplete="email" required></div>
          </div>
          <div class="fp-field"><label for="cf-subject">Subject</label><input id="cf-subject" type="text" name="contact[subject]"></div>
          <div class="fp-field"><label for="cf-body">Message</label><textarea id="cf-body" name="contact[body]" rows="5" class="fp-textarea" required></textarea></div>
          <button type="submit" class="fp-btn fp-btn--primary fp-btn--full"><span>Send message</span></button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "We're here to help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Questions about sizing, shipping or your order? Our team of pet parents replies within one business day." },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@frostpaws.com" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+1 (800) 555-0142" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Fri, 9am–6pm EST" }
  ],
  "presets": [ { "name": "Contact form" } ]
}
{% endschema %}
