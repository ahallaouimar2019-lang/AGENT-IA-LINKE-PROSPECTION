{%- comment -%} FrostPaws™ — Before / After slider {%- endcomment -%}
<section class="fp-section {{ section.settings.bg_class }}" id="{{ section.settings.anchor | default: 'before-after' }}">
  <div class="fp-container">
    <div class="fp-section__head fp-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="fp-overline">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="fp-h2" style="margin-top:var(--fp-space-3)">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="fp-body-lg fp-muted" style="margin-top:var(--fp-space-4)">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="fp-ba fp-reveal" data-fp-before-after style="--fp-ba-pos:50%">
      <div class="fp-ba__layer fp-ba__before">
        {% render 'frostpaws-image', image: section.settings.before_image, ratio: '16/10', slot: 'BEFORE_IMAGE', alt: section.settings.before_alt, sizes: '(min-width:900px) 820px, 100vw', loading: false %}
      </div>
      <div class="fp-ba__layer fp-ba__after">
        {% render 'frostpaws-image', image: section.settings.after_image, ratio: '16/10', slot: 'AFTER_IMAGE', alt: section.settings.after_alt, sizes: '(min-width:900px) 820px, 100vw', loading: false %}
      </div>
      <span class="fp-ba__tag fp-ba__tag--before">{{ section.settings.before_label }}</span>
      <span class="fp-ba__tag fp-ba__tag--after">{{ section.settings.after_label }}</span>
      <div class="fp-ba__handle" aria-hidden="true"><span class="fp-ba__grip">{% render 'frostpaws-icon', name: 'handle' %}</span></div>
      <input class="fp-ba__range" type="range" min="0" max="100" value="50" step="0.5"
             aria-label="Drag to compare before and after">
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before / after",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "before-after" },
    { "type": "select", "id": "bg_class", "label": "Background", "default": "",
      "options": [ { "value": "", "label": "Snow" }, { "value": "fp-section--alt", "label": "Frost" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "See the difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From restless to relaxed" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Drag the slider to see what a cool surface does for a hot, restless pet." },
    { "type": "header", "content": "Before" },
    { "type": "image_picker", "id": "before_image", "label": "BEFORE_IMAGE" },
    { "type": "text", "id": "before_alt", "label": "Before alt", "default": "Panting dog on a warm floor" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "header", "content": "After" },
    { "type": "image_picker", "id": "after_image", "label": "AFTER_IMAGE" },
    { "type": "text", "id": "after_alt", "label": "After alt", "default": "Calm dog resting on FrostPaws mat" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "With FrostPaws" }
  ],
  "presets": [ { "name": "Before / after" } ]
}
{% endschema %}
