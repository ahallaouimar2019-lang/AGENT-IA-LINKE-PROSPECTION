{%- comment -%} FrostPaws™ — List of Collections {%- endcomment -%}
<section class="fp-section">
  <div class="fp-container">
    <header class="fp-section__head fp-reveal">
      <span class="fp-overline">{{ section.settings.eyebrow }}</span>
      <h1 class="fp-h1" style="margin-top:var(--fp-space-3)">{{ section.settings.heading }}</h1>
    </header>
    <div class="fp-product-grid">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <a class="fp-card fp-card--interactive fp-collection-card" href="{{ collection.url }}">
            <div class="fp-media" style="aspect-ratio:4/3;">
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 800 | image_tag: class: 'fp-media__img', loading: 'lazy', widths: '300,500,800', sizes: '(min-width:900px) 33vw, 50vw', alt: collection.title }}
              {%- else -%}
                {% render 'frostpaws-image', ratio: '4/3', slot: 'COLLECTION_IMAGE', alt: collection.title %}
              {%- endif -%}
            </div>
            <div class="fp-collection-card__body">
              <h2 class="fp-h3">{{ collection.title }}</h2>
              <span class="fp-caption fp-muted">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</span>
            </div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "List collections",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by collection" }
  ]
}
{% endschema %}
