{%- comment -%} FrostPaws™ — Blog listing {%- endcomment -%}
<section class="fp-section">
  <div class="fp-container">
    <header class="fp-section__head fp-reveal">
      <span class="fp-overline">{{ section.settings.eyebrow }}</span>
      <h1 class="fp-h1" style="margin-top:var(--fp-space-3)">{{ blog.title }}</h1>
    </header>
    {%- paginate blog.articles by 9 -%}
      <div class="fp-product-grid">
        {%- for article in blog.articles -%}
          <a class="fp-card fp-card--interactive" href="{{ article.url }}">
            <div class="fp-media" style="aspect-ratio:16/10;margin-bottom:var(--fp-space-4)">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: class: 'fp-media__img', loading: 'lazy', widths: '300,500,800', sizes: '(min-width:900px) 33vw, 100vw', alt: article.title }}
              {%- else -%}
                {% render 'frostpaws-image', ratio: '16/10', slot: 'ARTICLE_IMAGE', alt: article.title %}
              {%- endif -%}
            </div>
            <span class="fp-caption fp-muted">{{ article.published_at | date: '%b %d, %Y' }}</span>
            <h2 class="fp-h3" style="margin-top:var(--fp-space-2)">{{ article.title }}</h2>
            <p class="fp-body fp-muted" style="margin-top:var(--fp-space-2)">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="fp-pagination" aria-label="Pagination">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a class="fp-pagination__link" href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}<span class="fp-pagination__link {% if part.title == paginate.current_page %}is-current{% endif %}">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "tag": "section", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Cool Down" }
] }
{% endschema %}
