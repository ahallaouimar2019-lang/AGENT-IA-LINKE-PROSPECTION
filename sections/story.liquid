{%- comment -%} FrostPaws™ — Story / About (image + narrative + stats) {%- endcomment -%}
<section class="fp-section {{ section.settings.bg_class }}">
  <div class="fp-container">
    <div class="fp-story {% if section.settings.image_first %}fp-story--reverse{% endif %}">
      <div class="fp-reveal">
        {% render 'frostpaws-image', image: section.settings.image, ratio: '4/5', slot: section.settings.slot_id, alt: section.settings.image_alt, sizes: '(min-width:900px) 45vw, 100vw' %}
      </div>
      <div class="fp-stack-lg fp-reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="fp-overline">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="fp-h2">{{ section.settings.heading }}</h2>
        <div class="fp-body-lg fp-muted fp-rte">{{ section.settings.body }}</div>
        {%- if section.blocks.size > 0 -%}
          <div class="fp-stats">
            {%- for block in section.blocks -%}
              <div class="fp-stat" {{ block.shopify_attributes }}>
                <span class="fp-stat__num">{{ block.settings.value }}</span>
                <span class="fp-stat__label fp-caption">{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a class="fp-btn fp-btn--primary" href="{{ section.settings.cta_link | default: '#' }}"><span>{{ section.settings.cta_label }}</span></a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "bg_class", "label": "Background", "default": "",
      "options": [ { "value": "", "label": "Snow" }, { "value": "fp-section--alt", "label": "Frost" } ] },
    { "type": "checkbox", "id": "image_first", "label": "Image on right", "default": false },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "slot_id", "label": "Placeholder ID", "default": "STORY_IMAGE" },
    { "type": "text", "id": "image_alt", "label": "Alt text", "default": "The FrostPaws team and their pets" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built by pet parents, for pets" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>FrostPaws started on a heatwave afternoon, watching a panting dog struggle to get comfortable on a hot floor. The cooling mats we could find were flimsy, ugly, or both. So we built the one we wished existed — engineered to actually stay cool, kind on joints, and quietly beautiful in any home.</p><p>Every mat we ship is the product we'd put down for our own dogs and cats. Nothing less makes the cut.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Keep them cool" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "settings": [
      { "type": "text", "id": "value", "label": "Value", "default": "40k+" },
      { "type": "text", "id": "label", "label": "Label", "default": "Cooler pets" }
    ]}
  ],
  "max_blocks": 4,
  "default": {
    "settings": {},
    "blocks": [
      { "type": "stat", "settings": { "value": "40k+", "label": "Cooler pets" } },
      { "type": "stat", "settings": { "value": "4.9★", "label": "Average rating" } },
      { "type": "stat", "settings": { "value": "30", "label": "Night trial" } }
    ]
  },
  "presets": [ { "name": "Story" } ]
}
{% endschema %}
