{%- comment -%}
  WLD — Puffy Landing (v3 · Luxe Dark Noir/Doré/Blanc)
  Section Shopify 100% autonome — aucune dépendance au thème.
  Nav (sans logo) + Hero moody + Trust bar 5 icônes + Stats + 7 produits
  + Bénéfices + Avis photo + Garantie + FAQ + CTA final.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div id="wld-puffy-{{ section.id }}" class="wld-puffy">

  {%- if section.settings.deal_text != blank -%}
  <div class="wld-puffy__deal">
    <span class="wld-puffy__deal-dot"></span>
    <span>{{ section.settings.deal_text }}</span>
  </div>
  {%- endif -%}

  {%- comment -%} ============ NAV (sans logo) ============ {%- endcomment -%}
  {%- if section.settings.show_nav -%}
  <nav class="wld-puffy__nav">
    <div class="wld-puffy__nav-inner">
      <span class="wld-puffy__nav-spacer" aria-hidden="true"></span>
      <ul class="wld-puffy__nav-links">
        {%- for i in (1..5) -%}
          {%- assign lbl = 'nav_' | append: i | append: '_label' -%}
          {%- assign lnk = 'nav_' | append: i | append: '_link' -%}
          {%- assign label = section.settings[lbl] -%}
          {%- if label != blank -%}
            <li{% if i == 1 %} class="is-active"{% endif %}><a href="{{ section.settings[lnk] | default: '#' }}">{{ label }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <div class="wld-puffy__nav-icons">
        <a href="{{ routes.search_url | default: '#' }}" aria-label="Recherche">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3" stroke-linecap="round"/></svg>
        </a>
        <a href="{{ routes.account_url | default: '#' }}" aria-label="Compte">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6" stroke-linecap="round"/></svg>
        </a>
        <a href="{{ routes.cart_url | default: '#' }}" aria-label="Panier">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8a3 3 0 0 1 6 0" stroke-linecap="round"/></svg>
        </a>
      </div>
    </div>
  </nav>
  {%- endif -%}

  {%- comment -%} ============ HERO ============ {%- endcomment -%}
  <section class="wld-puffy__hero">
    <div class="wld-puffy__hero-glow" aria-hidden="true"></div>
    <div class="wld-puffy__hero-inner">
      <div class="wld-puffy__hero-copy wld-r">
        {%- if section.settings.hero_eyebrow != blank -%}
          <p class="wld-puffy__eyebrow wld-puffy__eyebrow--spark">{{ section.settings.hero_eyebrow }}</p>
        {%- endif -%}
        <h1 class="wld-puffy__hero-title">{{ section.settings.hero_title }}</h1>
        <p class="wld-puffy__hero-sub">{{ section.settings.hero_subtitle }}</p>

        <div class="wld-puffy__hero-actions">
          <a href="{{ section.settings.hero_cta_link }}" class="wld-puffy__btn wld-puffy__btn--gold wld-puffy__btn--xl">
            {{ section.settings.hero_cta_label }}
          </a>
        </div>

        <div class="wld-puffy__social">
          <div class="wld-puffy__avatars">
            {%- for i in (1..3) -%}
              {%- assign av = 'hero_avatar_' | append: i -%}
              <span class="wld-puffy__avatar">
                {%- if section.settings[av] != blank -%}
                  <img src="{{ section.settings[av] | image_url: width: 96 }}" alt="Client" loading="lazy" width="48" height="48">
                {%- else -%}<span class="wld-puffy__avatar-ph">🐱</span>{%- endif -%}
              </span>
            {%- endfor -%}
          </div>
          <div class="wld-puffy__social-copy">
            <span class="wld-puffy__stars">★★★★★</span>
            <span class="wld-puffy__social-text">{{ section.settings.hero_social_text }}</span>
          </div>
        </div>
      </div>

      <div class="wld-puffy__hero-media wld-r">
        <div class="wld-puffy__hero-frame">
          {%- if section.settings.hero_image != blank -%}
            <img src="{{ section.settings.hero_image | image_url: width: 1100 }}"
                 alt="{{ section.settings.hero_title | escape }}" loading="eager" width="1100" height="1100">
          {%- else -%}
            <div class="wld-puffy__ph wld-puffy__ph--hero">🐱<span>Image hero (photo moody)</span></div>
          {%- endif -%}
        </div>
        {%- if section.settings.hero_pill != blank -%}
          <div class="wld-puffy__hero-pill">{{ section.settings.hero_pill }}</div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} ============ TRUST BAR (5 icônes dorées) ============ {%- endcomment -%}
  <section class="wld-puffy__trust">
    <div class="wld-puffy__trust-inner">
      {%- assign icons = 'cloud,shield,gift,globe,refresh' | split: ',' -%}
      {%- for i in (1..5) -%}
        {%- assign t = 'trust_' | append: i | append: '_title' -%}
        {%- assign s = 'trust_' | append: i | append: '_text' -%}
        {%- if section.settings[t] != blank -%}
        <div class="wld-puffy__trust-item wld-r">
          <span class="wld-puffy__trust-ic">
            {%- assign ic = icons[forloop.index0] -%}
            {%- case ic -%}
              {%- when 'cloud' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M7 18a4 4 0 0 1 0-8 5 5 0 0 1 9.6-1.5A3.5 3.5 0 0 1 17 18H7z"/><path d="M10.5 13.5c.6.9 1.4.9 2 0" stroke-linecap="round"/></svg>
              {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9.5 12l1.8 1.8L15 10" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'gift' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 10h16v9H4z"/><path d="M4 10l2-3h12l2 3M12 7v12" stroke-linecap="round"/><path d="M12 7c-2.5-3-5 0-2 2m2-2c2.5-3 5 0 2 2" stroke-linecap="round"/></svg>
              {%- when 'globe' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="8"/><path d="M4 12h16M12 4c2.5 2.5 2.5 13.5 0 16M12 4c-2.5 2.5-2.5 13.5 0 16"/></svg>
              {%- when 'refresh' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 12a7 7 0 0 1 12-5l2 2M19 12a7 7 0 0 1-12 5l-2-2" stroke-linecap="round"/><path d="M19 4v5h-5M5 20v-5h5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- endcase -%}
          </span>
          <div class="wld-puffy__trust-copy">
            <strong>{{ section.settings[t] }}</strong>
            <span>{{ section.settings[s] }}</span>
          </div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} ============ STAT BAND ============ {%- endcomment -%}
  <section class="wld-puffy__stats wld-r">
    <div class="wld-puffy__stat"><strong>{{ section.settings.stat_1_num }}</strong><span>{{ section.settings.stat_1_label }}</span></div>
    <div class="wld-puffy__stat"><strong>{{ section.settings.stat_2_num }}</strong><span>{{ section.settings.stat_2_label }}</span></div>
    <div class="wld-puffy__stat"><strong>{{ section.settings.stat_3_num }}</strong><span>{{ section.settings.stat_3_label }}</span></div>
    <div class="wld-puffy__stat"><strong>{{ section.settings.stat_4_num }}</strong><span>{{ section.settings.stat_4_label }}</span></div>
  </section>

  {%- comment -%} ============ 7 PRODUITS ============ {%- endcomment -%}
  <section class="wld-puffy__products">
    <div class="wld-puffy__section-head wld-r">
      <p class="wld-puffy__eyebrow">{{ section.settings.products_eyebrow }}</p>
      <h2 class="wld-puffy__h2">{{ section.settings.products_title }}</h2>
      <p class="wld-puffy__section-sub">{{ section.settings.products_subtitle }}</p>
    </div>

    <div class="wld-puffy__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' -%}
          <a href="{{ block.settings.link }}" class="wld-puffy__card wld-r" {{ block.shopify_attributes }}>
            {%- if block.settings.tag != blank -%}
              <span class="wld-puffy__card-tag">{{ block.settings.tag }}</span>
            {%- endif -%}
            <div class="wld-puffy__card-media">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 700 }}"
                     alt="{{ block.settings.name | escape }}" loading="lazy" width="700" height="700">
              {%- else -%}
                <div class="wld-puffy__ph">🐈<span>{{ block.settings.name }}</span></div>
              {%- endif -%}
            </div>
            <div class="wld-puffy__card-body">
              <p class="wld-puffy__card-cat">{{ block.settings.category }}</p>
              <h3 class="wld-puffy__card-name">{{ block.settings.name }}</h3>
              <div class="wld-puffy__card-rating"><span class="wld-puffy__stars wld-puffy__stars--sm">★★★★★</span></div>
              <div class="wld-puffy__card-foot">
                <span class="wld-puffy__card-price">{{ block.settings.price }}</span>
                <span class="wld-puffy__card-cta">{{ block.settings.cta }}</span>
              </div>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="wld-puffy__products-foot wld-r">
      <a href="{{ section.settings.hero_cta_link }}" class="wld-puffy__btn wld-puffy__btn--gold wld-puffy__btn--lg">
        {{ section.settings.products_button }}
      </a>
    </div>
  </section>

  {%- comment -%} ============ BÉNÉFICES ============ {%- endcomment -%}
  <section class="wld-puffy__benefits">
    <div class="wld-puffy__section-head wld-r">
      <p class="wld-puffy__eyebrow wld-puffy__eyebrow--gold">{{ section.settings.benefits_eyebrow }}</p>
      <h2 class="wld-puffy__h2">{{ section.settings.benefits_title }}</h2>
    </div>
    <div class="wld-puffy__ben-grid">
      <div class="wld-puffy__ben wld-r"><span>🌿</span><h4>{{ section.settings.ben_1_title }}</h4><p>{{ section.settings.ben_1_text }}</p></div>
      <div class="wld-puffy__ben wld-r"><span>🤍</span><h4>{{ section.settings.ben_2_title }}</h4><p>{{ section.settings.ben_2_text }}</p></div>
      <div class="wld-puffy__ben wld-r"><span>🎁</span><h4>{{ section.settings.ben_3_title }}</h4><p>{{ section.settings.ben_3_text }}</p></div>
      <div class="wld-puffy__ben wld-r"><span>👑</span><h4>{{ section.settings.ben_4_title }}</h4><p>{{ section.settings.ben_4_text }}</p></div>
    </div>
  </section>

  {%- comment -%} ============ AVIS PHOTO ============ {%- endcomment -%}
  <section class="wld-puffy__reviews">
    <div class="wld-puffy__section-head wld-r">
      <p class="wld-puffy__eyebrow">{{ section.settings.reviews_eyebrow }}</p>
      <h2 class="wld-puffy__h2">{{ section.settings.reviews_title }}</h2>
      <div class="wld-puffy__reviews-score">
        <span class="wld-puffy__stars">★★★★★</span>
        <strong>{{ section.settings.reviews_score }}</strong>
        <span>{{ section.settings.reviews_count }}</span>
      </div>
    </div>

    <div class="wld-puffy__reviews-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          {%- assign r = block.settings.rating | plus: 0 -%}
          <figure class="wld-puffy__review wld-r" {{ block.shopify_attributes }}>
            <div class="wld-puffy__review-photo">
              {%- if block.settings.photo != blank -%}
                <img src="{{ block.settings.photo | image_url: width: 600 }}"
                     alt="{{ block.settings.name | escape }}" loading="lazy" width="600" height="450">
              {%- else -%}
                <div class="wld-puffy__ph wld-puffy__ph--sm">📷</div>
              {%- endif -%}
            </div>
            <div class="wld-puffy__review-body">
              <span class="wld-puffy__stars wld-puffy__stars--sm" aria-label="{{ r }}/5">
                {%- for i in (1..5) -%}{%- if i <= r -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}
              </span>
              <blockquote>“{{ block.settings.text }}”</blockquote>
              <figcaption>
                <strong>{{ block.settings.name }}</strong>
                {%- if block.settings.verified -%}<span class="wld-puffy__verified">✔ {{ section.settings.verified_label }}</span>{%- endif -%}
              </figcaption>
            </div>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} ============ GARANTIE ============ {%- endcomment -%}
  <section class="wld-puffy__guarantee wld-r">
    <div class="wld-puffy__guar-inner">
      <div class="wld-puffy__guar-icon">🛡️</div>
      <div class="wld-puffy__guar-copy">
        <h3>{{ section.settings.guar_title }}</h3>
        <p>{{ section.settings.guar_text }}</p>
      </div>
      <a href="{{ section.settings.hero_cta_link }}" class="wld-puffy__btn wld-puffy__btn--gold">{{ section.settings.guar_button }}</a>
    </div>
  </section>

  {%- comment -%} ============ FAQ ============ {%- endcomment -%}
  <section class="wld-puffy__faq">
    <div class="wld-puffy__section-head wld-r">
      <p class="wld-puffy__eyebrow">{{ section.settings.faq_eyebrow }}</p>
      <h2 class="wld-puffy__h2">{{ section.settings.faq_title }}</h2>
    </div>
    <div class="wld-puffy__faq-list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
          <details class="wld-puffy__faq-item wld-r" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}<span class="wld-puffy__faq-ic">+</span></summary>
            <div class="wld-puffy__faq-a">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} ============ CTA FINAL ============ {%- endcomment -%}
  <section class="wld-puffy__final">
    <div class="wld-puffy__final-glow" aria-hidden="true"></div>
    <div class="wld-puffy__final-inner wld-r">
      <p class="wld-puffy__eyebrow wld-puffy__eyebrow--gold">{{ section.settings.final_eyebrow }}</p>
      <h2 class="wld-puffy__final-title">{{ section.settings.final_title }}</h2>
      <p class="wld-puffy__final-sub">{{ section.settings.final_subtitle }}</p>
      <a href="{{ section.settings.hero_cta_link }}" class="wld-puffy__btn wld-puffy__btn--gold wld-puffy__btn--xl">
        {{ section.settings.final_button }}
      </a>
      <p class="wld-puffy__reassurance">{{ section.settings.final_reassurance }}</p>
    </div>
  </section>

</div>

{%- style -%}
  #wld-puffy-{{ section.id }} *{ box-sizing:border-box; }
  #wld-puffy-{{ section.id }}{
    --ink:{{ section.settings.color_ink }};
    --panel:{{ section.settings.color_panel }};
    --gold:{{ section.settings.color_gold }};
    --gold-2:{{ section.settings.color_gold_soft }};
    --cream:{{ section.settings.color_cream }};
    --muted:rgba(245,239,227,.66);
    --line:rgba(201,162,75,.22);
    font-family:'Inter',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    color:var(--cream); line-height:1.6; background:var(--ink);
    -webkit-font-smoothing:antialiased; overflow:hidden;
  }
  #wld-puffy-{{ section.id }} h1,#wld-puffy-{{ section.id }} h2,
  #wld-puffy-{{ section.id }} h3,#wld-puffy-{{ section.id }} h4{ margin:0; font-weight:400; }
  #wld-puffy-{{ section.id }} p{ margin:0; }
  #wld-puffy-{{ section.id }} a{ text-decoration:none; color:inherit; }
  #wld-puffy-{{ section.id }} .wld-puffy__eyebrow{
    text-transform:uppercase; letter-spacing:.3em; font-size:11px; font-weight:700; color:var(--gold); margin-bottom:18px;
  }
  #wld-puffy-{{ section.id }} .wld-puffy__eyebrow--spark::before{ content:'✦  '; color:var(--gold); }
  #wld-puffy-{{ section.id }} .wld-puffy__eyebrow--spark::after{ content:'  ✦'; color:var(--gold); }
  #wld-puffy-{{ section.id }} .wld-puffy__h2{
    font-family:'DM Serif Display',Georgia,serif; font-size:clamp(30px,4.2vw,52px); line-height:1.06; letter-spacing:-.01em; color:var(--cream);
  }
  #wld-puffy-{{ section.id }} .wld-puffy__stars{ color:var(--gold); letter-spacing:3px; font-size:16px; text-shadow:0 0 12px rgba(201,162,75,.4); }
  #wld-puffy-{{ section.id }} .wld-puffy__stars--sm{ font-size:14px; letter-spacing:2px; }

  /* Reveal */
  #wld-puffy-{{ section.id }} .wld-r{ opacity:0; transform:translateY(22px); transition:opacity .7s ease, transform .7s cubic-bezier(.16,.84,.44,1); }
  #wld-puffy-{{ section.id }} .wld-r.is-in{ opacity:1; transform:none; }

  /* Deal bar */
  #wld-puffy-{{ section.id }} .wld-puffy__deal{
    background:#000; color:var(--gold-2); text-align:center; padding:11px 16px; font-size:12.5px; font-weight:600;
    letter-spacing:.08em; text-transform:uppercase; display:flex; gap:10px; align-items:center; justify-content:center;
  }
  #wld-puffy-{{ section.id }} .wld-puffy__deal-dot{ width:7px;height:7px;border-radius:50%;background:var(--gold);animation:wldPulse 1.8s infinite;}
  @keyframes wldPulse{0%{box-shadow:0 0 0 0 rgba(201,162,75,.6);}70%{box-shadow:0 0 0 8px rgba(201,162,75,0);}100%{box-shadow:0 0 0 0 rgba(201,162,75,0);}}

  /* Nav */
  #wld-puffy-{{ section.id }} .wld-puffy__nav{ border-bottom:1px solid var(--line); background:rgba(0,0,0,.25); }
  #wld-puffy-{{ section.id }} .wld-puffy__nav-inner{ max-width:1240px; margin:0 auto; padding:20px 24px; display:flex; align-items:center; justify-content:space-between; gap:20px; }
  #wld-puffy-{{ section.id }} .wld-puffy__nav-spacer{ flex:1; }
  #wld-puffy-{{ section.id }} .wld-puffy__nav-links{ display:flex; gap:38px; list-style:none; margin:0; padding:0; flex:2; justify-content:center; }
  #wld-puffy-{{ section.id }} .wld-puffy__nav-links a{ font-size:13px; letter-spacing:.14em; text-transform:uppercase; font-weight:600; color:var(--cream); opacity:.85; transition:opacity .2s, color .2s; }
  #wld-puffy-{{ section.id }} .wld-puffy__nav-links a:hover{ color:var(--gold); opacity:1; }
  #wld-puffy-{{ section.id }} .wld-puffy__nav-links .is-active a{ color:var(--gold); opacity:1; position:relative; }
  #wld-puffy-{{ section.id }} .wld-puffy__nav-links .is-active a::after{ content:''; position:absolute; left:0; right:0; bottom:-8px; height:2px; background:var(--gold); }
  #wld-puffy-{{ section.id }} .wld-puffy__nav-icons{ display:flex; gap:20px; flex:1; justify-content:flex-end; }
  #wld-puffy-{{ section.id }} .wld-puffy__nav-icons a{ color:var(--cream); opacity:.85; transition:color .2s, opacity .2s; }
  #wld-puffy-{{ section.id }} .wld-puffy__nav-icons a:hover{ color:var(--gold); opacity:1; }
  #wld-puffy-{{ section.id }} .wld-puffy__nav-icons svg{ width:21px; height:21px; display:block; }

  /* Buttons */
  #wld-puffy-{{ section.id }} .wld-puffy__btn{
    display:inline-block; font-weight:700; border-radius:999px; padding:16px 34px; font-size:15px;
    letter-spacing:.06em; text-transform:uppercase; transition:transform .18s ease, box-shadow .18s ease; border:1px solid transparent; cursor:pointer;
  }
  #wld-puffy-{{ section.id }} .wld-puffy__btn--gold{
    background:linear-gradient(135deg,var(--gold-2),var(--gold)); color:#1a1407; box-shadow:0 12px 34px rgba(201,162,75,.4);
  }
  #wld-puffy-{{ section.id }} .wld-puffy__btn--gold:hover{ transform:translateY(-2px); box-shadow:0 18px 44px rgba(201,162,75,.6); }
  #wld-puffy-{{ section.id }} .wld-puffy__btn--xl{ padding:19px 46px; font-size:16px; }
  #wld-puffy-{{ section.id }} .wld-puffy__btn--lg{ padding:17px 40px; font-size:15px; }

  /* Hero */
  #wld-puffy-{{ section.id }} .wld-puffy__hero{ position:relative; overflow:hidden; }
  #wld-puffy-{{ section.id }} .wld-puffy__hero-glow{
    position:absolute; width:680px; height:680px; right:-140px; top:-120px; pointer-events:none;
    background:radial-gradient(closest-side,rgba(201,162,75,.22),transparent 70%);
  }
  #wld-puffy-{{ section.id }} .wld-puffy__hero-inner{
    position:relative; max-width:1240px; margin:0 auto; padding:74px 24px 84px; display:grid;
    grid-template-columns:1.02fr 1fr; gap:56px; align-items:center;
  }
  #wld-puffy-{{ section.id }} .wld-puffy__hero-title{
    font-family:'DM Serif Display',Georgia,serif; font-size:clamp(42px,6.2vw,78px); line-height:1.0; margin-bottom:22px; letter-spacing:-.02em; color:#fff;
  }
  #wld-puffy-{{ section.id }} .wld-puffy__hero-title em{
    font-style:italic; display:block;
    background:linear-gradient(120deg,var(--gold-2),var(--gold)); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; color:var(--gold);
  }
