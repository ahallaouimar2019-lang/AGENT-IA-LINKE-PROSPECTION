{%- comment -%} FrostPaws™ — Policy pages (privacy, refund, terms, shipping) {%- endcomment -%}
<section class="fp-section">
  <div class="fp-container" style="max-width:820px">
    <header class="fp-section__head" style="margin-bottom:var(--fp-space-8)">
      <span class="fp-overline">Legal</span>
      <h1 class="fp-h1" style="margin-top:var(--fp-space-3)">{{ policy.title }}</h1>
    </header>
    <div class="fp-rte fp-body">{{ policy.body }}</div>
  </div>
</section>
