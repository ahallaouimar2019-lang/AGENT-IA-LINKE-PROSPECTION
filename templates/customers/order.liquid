{%- comment -%} FrostPaws™ — Customer Order detail {%- endcomment -%}
<section class="fp-section">
  <div class="fp-container">
    <a class="fp-btn fp-btn--text" href="{{ routes.account_url }}"><span class="fp-btn__arrow">←</span> <span class="fp-btn__label">Back to account</span></a>
    <header style="margin:var(--fp-space-6) 0 var(--fp-space-8)">
      <span class="fp-overline">Order {{ order.name }}</span>
      <h1 class="fp-h1" style="margin-top:var(--fp-space-3)">Placed {{ order.created_at | date: '%B %d, %Y' }}</h1>
      <div class="fp-trust" style="margin-top:var(--fp-space-4)">
        <span class="fp-trust__item">{% render 'frostpaws-icon', name: 'package' %} {{ order.fulfillment_status_label }}</span>
        <span class="fp-trust__item">{% render 'frostpaws-icon', name: 'lock' %} {{ order.financial_status_label }}</span>
      </div>
    </header>

    <div class="fp-cart-items">
      {%- for line in order.line_items -%}
        <div class="fp-cart-item">
          <div class="fp-cart-item__media">
            <div class="fp-media" style="aspect-ratio:1/1;width:80px;">
              {%- if line.image -%}{{ line.image | image_url: width: 160 | image_tag: class: 'fp-media__img', loading: 'lazy', widths: '80,160', sizes: '80px', alt: line.title }}
              {%- else -%}{% render 'frostpaws-image', ratio: '1/1', slot: 'PRODUCT_IMAGE', alt: line.title %}{%- endif -%}
            </div>
          </div>
          <div class="fp-cart-item__info">
            <span class="fp-cart-item__title">{{ line.title }}</span>
            <span class="fp-caption fp-muted">Qty {{ line.quantity }}</span>
          </div>
          <div class="fp-cart-item__total fp-tabular">{{ line.final_line_price | money }}</div>
        </div>
      {%- endfor -%}
    </div>

    <div class="fp-card" style="max-width:360px;margin-left:auto;margin-top:var(--fp-space-6)">
      <div class="fp-cart-summary__row"><span>Subtotal</span><span class="fp-tabular">{{ order.line_items_subtotal_price | money }}</span></div>
      <div class="fp-cart-summary__row"><span>Shipping</span><span class="fp-tabular">{{ order.shipping_price | money }}</span></div>
      <div class="fp-cart-summary__row"><span>Tax</span><span class="fp-tabular">{{ order.tax_price | money }}</span></div>
      <div class="fp-cart-summary__row fp-cart-summary__row--total"><span>Total</span><span class="fp-tabular">{{ order.total_net_amount | money }}</span></div>
    </div>
  </div>
</section>
