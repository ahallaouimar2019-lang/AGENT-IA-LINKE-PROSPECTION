{%- comment -%} Default page uses the flexible JSON template; this Liquid fallback renders content directly. {%- endcomment -%}
<section class="fp-section">
  <div class="fp-container" style="max-width:820px">
    <header class="fp-section__head" style="margin-bottom:var(--fp-space-8)">
      <span class="fp-overline">FrostPaws</span>
      <h1 class="fp-h1" style="margin-top:var(--fp-space-3)">{{ page.title }}</h1>
    </header>
    <div class="fp-rte fp-body">{{ page.content }}</div>
  </div>
</section>
